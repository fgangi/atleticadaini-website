---
import SocialIcons from './SocialIcons.astro';
import CinqueMini from './CinqueMini.astro';
// Logo ufficiale per fondi scuri, inserito nella pagina (non come immagine) per
// poterlo animare: scorrendo "AINI" svanisce e resta la "D". Le classi interne
// del file prendono un prefisso, perché gli stili di un SVG nella pagina valgono ovunque.
import logoSvgGrezzo from '../../public/loghi/logo-daini-chiaro.svg?raw';
const logoSvg = logoSvgGrezzo
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/cls-/g, 'lh-')
  .replace('<path class="lh-1"', '<path class="lh-1 logo-aini"')
  .replace('<svg ', '<svg class="logo-svg" aria-hidden="true" focusable="false" ');

type Voce = { href: string; label: string; risalto?: boolean; children?: { href: string; label: string }[] };
interface Props {
  nome: string;
  social?: Record<string, string> | null;
  /** Promemoria del 5×1000 nella striscia in alto (acceso dal pannello) */
  cinque?: { cf: string; testo?: string | null } | null;
  /** Sezioni che compaiono solo quando hanno contenuto: la voce le segue */
  presenze: { album: number; record: number; team: number; collaborazioni?: number; storia: number; corsi: number; quote: number; iscrizioniAperte: boolean; openDay: boolean };
}
const { nome, social, cinque, presenze: p } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav: Voce[] = [
  { href: '/', label: 'Home' },
  {
    href: '/societa/', label: 'Società',
    // Le tendine elencano sezioni e sottopagine che esistono davvero
    children: [
      { href: '/societa/', label: 'Chi siamo' },
      ...(p.storia ? [{ href: '/societa/storia/', label: 'Storia' }] : []),
      ...(p.team ? [{ href: '/societa/team/', label: 'Team' }] : []),
      ...(p.collaborazioni ? [{ href: '/societa/collaborazioni/', label: 'Collaborazioni' }] : []),
      // Record: storia sportiva della società, consultata di rado dai genitori
      ...(p.record ? [{ href: '/societa/record/', label: 'Record' }] : []),
    ],
  },
  {
    href: '/settore-giovanile/', label: 'Settore giovanile',
    children: [
      ...(p.corsi ? [{ href: '/settore-giovanile/#corsi', label: 'Corsi e orari' }] : []),
      ...(p.quote ? [{ href: '/settore-giovanile/#quote', label: 'Quote' }] : []),
      { href: '/settore-giovanile/#iscrizioni', label: 'Come iscriversi' },
    ],
  },
  // Open days: voce propria, messa in risalto, finché è accesa nel pannello
  ...(p.openDay ? [{ href: '/open-days/', label: 'Open days', risalto: true }] : []),
  { href: '/impianto/', label: 'Impianto' },
  { href: '/news/', label: 'News' },
  // Gallery in vista: le foto delle gare sono tra le pagine più cercate dalle famiglie
  ...(p.album ? [{ href: '/gallery/', label: 'Gallery' }] : []),
  { href: '/contatti/', label: 'Contatti' },
];
// Con una sola voce la tendina non serve: resta un link diretto
nav.forEach((v) => { if (v.children && v.children.length < 2) delete v.children; });

const attiva = (href: string) => {
  // I link hanno lo slash finale, il pathname no: normalizzo entrambi
  const pulito = href.split('#')[0].replace(/\/$/, '') || '/';
  if (pulito === '/gallery') return path.startsWith('/gallery');
  return path === pulito || path.startsWith(pulito + '/');
};
// Nelle tendine "pagina corrente" è solo la pagina esatta (o un album dentro Gallery):
// "Chi siamo" non deve risultare attiva mentre si guarda la Storia
const correnteEsatta = (href: string) => {
  if (href.includes('#')) return false;
  const pulito = href.replace(/\/$/, '') || '/';
  return pulito === '/gallery' ? path.startsWith('/gallery') : path === pulito;
};
// "Società" è attiva anche nelle pagine della sua tendina (es. Record)
const attivaVoce = (v: Voce) => attiva(v.href) || !!v.children?.some((c) => attiva(c.href));
const conSocial = Object.values(social ?? {}).some((u) => typeof u === 'string' && u.startsWith('http'));
---
<header class:list={['site-header', 'sfondo-scuro', { 'senza-striscia': !conSocial && !cinque }]} data-header>
  {(conSocial || cinque) && (
    <div class="topbar">
      <div class="container">
        {/* 5×1000 accanto ai social, a destra */}
        <div class="topbar-destra">
          {cinque && <CinqueMini cf={cinque.cf} testo={cinque.testo} />}
          {conSocial && <SocialIcons social={social} />}
        </div>
      </div>
    </div>
  )}

  <div class="container bar">
    <a class="brand" href="/" aria-label={`${nome} – home`}>
      {/* Logo intero, alto quanto tutto l'header; scorrendo lascia il posto al solo simbolo */}
      {/* Finestra sul logo: in cima mostra tutto "Daini", scorrendo si stringe sulla "D" */}
      <span class="brand-finestra" set:html={logoSvg} />
    </a>

    <button class="nav-toggle" type="button" aria-label="Apri il menu" aria-expanded="false" data-nav-toggle>
      <svg class="ico-apri" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg class="ico-chiudi" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
    </button>

    <nav class="mainnav" data-nav data-open="false" aria-label="Navigazione principale">
      {nav.map((v) => v.children ? (
        <div class="mainnav-item has-sub" data-sub data-open="false">
          <button class="mainnav-link mainnav-trigger" type="button" aria-expanded="false" data-trigger data-active={attivaVoce(v) ? 'true' : undefined}>
            {v.label}
            <svg class="caret" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="submenu">
            {v.children.map((c) => (
              <a href={c.href} aria-current={correnteEsatta(c.href) ? 'page' : undefined}>{c.label}</a>
            ))}
          </div>
        </div>
      ) : (
        <a class:list={['mainnav-link', { risalto: v.risalto }]} href={v.href} aria-current={attiva(v.href) ? 'page' : undefined}>{v.label}</a>
      ))}
      {/* Il pulsante segue l'interruttore "Iscrizioni aperte" del pannello.
          In sviluppo esiste sempre: la barra "Anteprima stati" lo mostra o lo nasconde. */}
      {(p.iscrizioniAperte || import.meta.env.DEV) && (
        <a class="btn cta nav-cta" href="/settore-giovanile/#iscrizioni" data-sim-iscrizioni="aperte" hidden={!p.iscrizioniAperte}>Iscriviti</a>
      )}
    </nav>
  </div>
</header>
{/* L'header è fisso in alto: questo spazio tiene il suo posto nella pagina.
    Ha sempre l'altezza piena, così quando l'header si stringe il contenuto non salta */}
<div class:list={['header-spazio', { 'senza-striscia': !conSocial && !cinque }]} aria-hidden="true"></div>

<style>
  /* Header fisso con un'unica sfumatura verde (come Corigliano Volley). In cima:
     striscia dei social + barra con il logo grande. Scorrendo (classe
     "compatto") la striscia sparisce e la barra si stringe col solo simbolo.
     Lo spazio sotto resta sempre alto uguale: la pagina non salta. */
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    background: linear-gradient(90deg, var(--verde) 0%, var(--verde-scuro) 100%); color: #fff;
    box-shadow: 0 1px 0 rgba(0, 0, 0, .12);
  }
  .header-spazio { height: calc(var(--altezza-striscia) + var(--altezza-intestazione)); }
  .header-spazio.senza-striscia { height: var(--altezza-intestazione); }
  /* overflow visibile: il riquadro del 5×1000 si apre sotto la striscia */
  .topbar { height: var(--altezza-striscia); transition: height .2s ease, opacity .2s ease; }
  .topbar .container { position: relative; display: flex; justify-content: flex-end; align-items: center; height: 100%; }
  .topbar-destra { display: flex; align-items: center; gap: 6px; }
  /* Icone nude nella striscia, ma con bersaglio di tocco pieno da 44px */
  .topbar :global(.social-icons) { margin: 0; gap: 0; }
  .topbar :global(.social-icons a) { width: 44px; height: 44px; border: 0; border-radius: 8px; opacity: .88; transition: transform .12s ease, opacity .12s ease; }
  /* Al passaggio del mouse l'icona si accende e si solleva appena (come Corigliano Volley) */
  .topbar :global(.social-icons a:hover) { opacity: 1; background: transparent; color: #fff; transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .topbar :global(.social-icons a:hover) { transform: none; } }
  .topbar :global(.social-icons svg) { width: 18px; height: 18px; }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: var(--altezza-intestazione);
    transition: height .2s ease; }
  /* Il logo sale nella striscia: occupa tutta l'altezza dell'header */
  .brand { display: flex; align-items: center; min-height: 44px; flex: none; color: #fff; align-self: flex-end;
    margin-top: calc(-1 * var(--altezza-striscia)); height: calc(var(--altezza-striscia) + var(--altezza-intestazione)); }
  .senza-striscia .brand { margin-top: 0; height: var(--altezza-intestazione); }
  .senza-striscia .brand-finestra { --alto: var(--altezza-intestazione); }
  /* Logo animato. --h è l'altezza del disegno: in cima quella dell'header (meno un
     margine) ma limitata dalla larghezza disponibile; il logo è largo 2,47 volte
     l'altezza, la sola "D" 1,47. La finestra stringendosi nasconde "AINI". */
  .brand-finestra {
    --alto: calc(var(--altezza-striscia) + var(--altezza-intestazione));
    --h: min(calc(var(--alto) - 20px), calc(var(--logo-max) / 2.465));
    --logo-max: 240px;
    display: block; overflow: hidden;
    height: var(--h); width: calc(var(--h) * 2.465);
    transition: width .35s ease, height .35s ease;
  }
  .brand-finestra :global(.logo-svg) { display: block; height: 100%; width: auto; }
  .brand-finestra :global(.logo-aini) { transition: opacity .25s ease, transform .35s ease; }
  .site-header.compatto .topbar { height: 0; opacity: 0; overflow: hidden; visibility: hidden; }
  .site-header.compatto .bar { height: var(--altezza-compatta); }
  .site-header.compatto .brand { margin-top: 0; height: var(--altezza-compatta); align-self: center; }
  .site-header.compatto .brand-finestra { --h: calc(var(--altezza-compatta) - 18px); width: calc(var(--h) * 1.47); }
  .site-header.compatto .brand-finestra :global(.logo-aini) { opacity: 0; transform: translateX(24px); }
  .brand { transition: margin-top .35s ease, height .35s ease; }
  @media (prefers-reduced-motion: reduce) {
    .topbar, .bar, .brand, .brand-finestra, .brand-finestra :global(.logo-aini) { transition: none; }
  }
  /* Telefono: la striscia è piena (5×1000 e social), il logo resta nella barra */
  @media (max-width: 639px) {
    .brand { margin-top: 0; height: var(--altezza-intestazione); align-self: center; }
    .brand-finestra { --logo-max: 150px; --alto: var(--altezza-intestazione); }
  }

  /* --- menu da PC (da 1024px) --- */
  .mainnav { display: flex; align-items: center; gap: 2px; }
  .mainnav-link {
    display: inline-flex; align-items: center; gap: .3rem; min-height: 44px; padding: 0 .7rem;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .03em;
    font-size: var(--fs-menu); font-weight: 700; color: #fff; white-space: nowrap;
    border: 0; background: transparent; cursor: pointer; border-radius: 8px;
  }
  .mainnav-link:hover { background: rgba(255, 255, 255, .1); }
  /* Pagina corrente: filetto giallo sotto, come la barra del volantino */
  .mainnav-link[aria-current='page'], .mainnav-link[data-active='true'] { box-shadow: inset 0 -3px 0 var(--giallo); border-radius: 0; }
  /* Open days: stessa voce del menu, ma in giallo chiaro per farsi notare */
  .mainnav-link.risalto { color: var(--giallo); }
  .mainnav-link.risalto:hover { color: var(--giallo-chiaro); }
  .caret { opacity: .8; transition: transform .15s ease; flex: none; }
  .mainnav-item { position: relative; }
  .mainnav-item[data-open='true'] .caret { transform: rotate(180deg); }
  .submenu { display: none; flex-direction: column; }
  .mainnav-item[data-open='true'] > .submenu { display: flex; }
  .nav-cta { margin-left: 10px; }
  .nav-toggle { display: none; }

  /* PC stretti (1024–1279px): 9 voci più "Iscriviti" stanno su una riga solo
     stringendo un po' spaziatura e carattere */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .mainnav-link { padding: 0 .48rem; font-size: calc(var(--fs-menu) * .93); }
    .nav-cta { margin-left: 6px; padding: 0 1rem; }
    .brand-finestra { --logo-max: 170px; }
  }
  /* PC larghi: logo grande e voci un po' più strette, così il menu non esce dal margine */
  @media (min-width: 1280px) {
    .mainnav-link { padding: 0 .55rem; }
    .brand-finestra { --logo-max: 210px; }
  }
  @media (min-width: 1024px) {
    .submenu {
      position: absolute; top: 100%; left: 0; min-width: 220px; z-index: 1001;
      /* padding-top fa da "ponte" fra bottone e tendina: il mouse non la perde */
      padding: 10px 6px 6px; gap: 2px;
    }
    .submenu::before {
      content: ''; position: absolute; inset: 6px 0 0 0; z-index: -1;
      background: var(--ground); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow);
    }
    /* Su PC la tendina si apre anche al passaggio del mouse */
    .mainnav-item.has-sub:hover > .submenu, .mainnav-item.has-sub:focus-within > .submenu { display: flex; }
    .mainnav-item.has-sub:hover .caret { transform: rotate(180deg); }
    .submenu a {
      display: flex; align-items: center; min-height: 44px; padding: 0 .8rem; border-radius: 8px;
      color: var(--ink-soft); white-space: nowrap;
      font-family: var(--font-display); text-transform: uppercase; letter-spacing: .03em; font-size: var(--fs-menu-tendina); font-weight: 700;
    }
    .submenu a:hover, .submenu a[aria-current='page'] { background: var(--surface-2); color: var(--verde); }
  }

  /* --- menu da telefono e tablet: pannello a scomparsa + tendine a fisarmonica --- */
  @media (max-width: 1023px) {
    .nav-toggle {
      display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px;
      border: 1px solid rgba(255, 255, 255, .3); background: transparent; border-radius: 10px; cursor: pointer; color: #fff; flex: none;
    }
    .nav-toggle .ico-chiudi { display: none; }
    .nav-toggle[aria-expanded='true'] .ico-apri { display: none; }
    .nav-toggle[aria-expanded='true'] .ico-chiudi { display: block; }
    .mainnav {
      position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch;
      background: var(--verde-scuro); border-top: 1px solid rgba(255, 255, 255, .12);
      padding: 8px clamp(16px, 4vw, 32px) 20px; gap: 0; display: none;
      max-height: calc(100dvh - var(--altezza-compatta)); overflow-y: auto; z-index: 1001;
    }
    .mainnav[data-open='true'] { display: flex; }
    .mainnav-link { width: 100%; justify-content: space-between; min-height: 52px; font-size: calc(var(--fs-menu) * 1.09); border-radius: 0;
      border-bottom: 1px solid rgba(255, 255, 255, .08); }
    .mainnav-link[aria-current='page'], .mainnav-link[data-active='true'] { box-shadow: inset 3px 0 0 var(--giallo); }
    .submenu { padding: 4px 0 8px 1rem; }
    .submenu a { display: flex; align-items: center; min-height: 44px; color: rgba(255, 255, 255, .8);
      font-family: var(--font-display); text-transform: uppercase; letter-spacing: .03em; font-size: calc(var(--fs-menu-tendina) * 1.03); font-weight: 700; }
    .submenu a:hover, .submenu a[aria-current='page'] { color: var(--giallo); }
    .nav-cta { margin: 16px 0 0; }
  }
</style>

<script>
// Header compatto scorrendo. Due soglie diverse (entra a 80px, esce sotto 24px):
// fermandosi sul confine l'header non si apre e chiude di continuo
function initCompatto() {
  const h = document.querySelector<HTMLElement>('[data-header]');
  if (!h || h.dataset.scroll) return;
  h.dataset.scroll = '1';
  let attesa = false;
  const aggiorna = () => {
    attesa = false;
    const y = window.scrollY;
    if (y > 80 && !h.classList.contains('compatto')) {
      h.classList.add('compatto');
      // La striscia sparisce: il riquadro del 5×1000 eventualmente aperto si chiude
      h.querySelector<HTMLDetailsElement>('[data-cinque-mini]')?.removeAttribute('open');
    }
    else if (y < 24) h.classList.remove('compatto');
  };
  aggiorna();
  window.addEventListener('scroll', () => { if (!attesa) { attesa = true; requestAnimationFrame(aggiorna); } }, { passive: true });
}
initCompatto();
document.addEventListener('astro:page-load', initCompatto);

// Con le transizioni fra pagine lo script si riesegue: il flag "bound"
// evita di agganciare due volte gli stessi eventi.
function initHeader() {
  const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  const items = Array.from(document.querySelectorAll('[data-sub]'));
  if (!toggle || !nav || toggle.dataset.bound === '1') return;
  toggle.dataset.bound = '1';

  /** Chiude tutte le tendine, tranne quella indicata. */
  const chiudiTendine = (tranne?: Element) => items.forEach((i) => {
    if (i === tranne) return;
    i.setAttribute('data-open', 'false');
    i.querySelector('[data-trigger]')?.setAttribute('aria-expanded', 'false');
  });
  const chiudiMenu = () => {
    nav.setAttribute('data-open', 'false');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Apri il menu');
  };

  toggle.addEventListener('click', (e) => {
    e.stopPropagation();
    const aperto = nav.getAttribute('data-open') === 'true';
    nav.setAttribute('data-open', String(!aperto));
    toggle.setAttribute('aria-expanded', String(!aperto));
    toggle.setAttribute('aria-label', aperto ? 'Apri il menu' : 'Chiudi il menu');
    if (aperto) chiudiTendine();
  });

  // Su PC la tendina si apre già al passaggio del mouse (CSS);
  // il click resta per touch e tastiera.
  items.forEach((item) => {
    const trigger = item.querySelector('[data-trigger]');
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const aperta = item.getAttribute('data-open') === 'true';
      chiudiTendine(item);
      item.setAttribute('data-open', String(!aperta));
      trigger.setAttribute('aria-expanded', String(!aperta));
    });
    // Allontanando il mouse, una tendina aperta col click non resta bloccata
    item.addEventListener('mouseleave', () => {
      if (!matchMedia('(min-width: 1024px)').matches) return;
      item.setAttribute('data-open', 'false');
      trigger?.setAttribute('aria-expanded', 'false');
    });
  });

  // Toccando un link a una sezione della stessa pagina il menu si chiude
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { chiudiTendine(); chiudiMenu(); }));

  // Click fuori dal menu: chiude tutto
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    if (e.target.closest('[data-nav]') || e.target.closest('[data-nav-toggle]')) return;
    chiudiTendine();
    chiudiMenu();
  });

  // Esc chiude e riporta il focus al comando che aveva aperto
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const aperta = items.find((i) => i.getAttribute('data-open') === 'true');
    const menuAperto = nav.getAttribute('data-open') === 'true';
    chiudiTendine();
    chiudiMenu();
    if (aperta) aperta.querySelector<HTMLElement>('[data-trigger]')?.focus();
    else if (menuAperto) toggle.focus();
  });
}

initHeader();
document.addEventListener('astro:page-load', initHeader);
// Cambiando pagina il menu del telefono va richiuso
document.addEventListener('astro:before-swap', () => {
  document.querySelector('[data-nav]')?.setAttribute('data-open', 'false');
  document.querySelectorAll('[data-sub]').forEach((i) => i.setAttribute('data-open', 'false'));
});
</script>
