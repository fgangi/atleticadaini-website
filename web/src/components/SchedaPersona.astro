---
import { img, telHref, formatTel } from '../lib/sanity';

/**
 * Scheda di una persona del team: foto (o iniziali su verde finché non c'è),
 * nome, ruolo e telefono. Le righe ci sono sempre, anche vuote, così tutte
 * le schede hanno la stessa struttura e i nomi stanno alla stessa altezza.
 */
interface Props { m: any; gruppi?: string[] }
const { m, gruppi } = Astro.props;
const foto = img(m.foto, 400, 480);
const iniziali = String(m.nome ?? '').split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
---
<article class="card persona">
  <div class="p-foto">
    {foto ? <img src={foto} alt="" loading="lazy" /> : <span class="p-iniziali" aria-hidden="true">{iniziali}</span>}
  </div>
  <div class="p-corpo">
    <h3>{m.nome}</h3>
    {/* Il gruppo allenato è l'informazione utile al genitore: in evidenza.
        Riga sempre presente se la griglia li mostra, così le schede restano uguali */}
    {gruppi && <p class="p-gruppi">{gruppi.join(', ')}</p>}
    {/* Dopo la barra di "Istruttore/istruttrice" si può andare a capo, non a metà parola */}
    <p class="p-ruolo">{String(m.ruolo ?? '').split('/').map((x, i) => <>{i > 0 && <>/<wbr /></>}{x}</>)}</p>
    {m.telefono
      ? (
        <a class="p-tel tabnums" href={telHref(m.telefono)} aria-label={`Chiama ${m.nome}: ${formatTel(m.telefono)}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          {formatTel(m.telefono)}
        </a>
      )
      : <span class="p-tel" aria-hidden="true"></span>}
  </div>
</article>
<style>
  .persona { display: flex; flex-direction: column; height: 100%; }
  .p-foto { aspect-ratio: 5 / 6; background: var(--sfondo-scuro); display: grid; place-items: center; overflow: hidden; }
  .p-foto img { width: 100%; height: 100%; object-fit: cover; }
  .p-iniziali { font-family: var(--font-display); font-size: 3.4rem; font-weight: 800; color: var(--giallo-chiaro); letter-spacing: .04em; }
  .p-corpo { flex: 1; padding: 14px 16px 12px; display: flex; flex-direction: column; gap: 4px; }
  .p-gruppi { min-height: 1.2em; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .03em; font-weight: 700; color: var(--verde); font-size: var(--fs-etichetta); line-height: 1.2; }
  /* Ruolo in testo normale: il gruppo sopra conta di più */
  .p-ruolo { min-height: 1.4em; color: var(--ink-soft); font-size: var(--fs-testo-secondario); line-height: 1.4; }
  /* Numero in fondo alla scheda, toccabile: serve per gare e organizzazione */
  .p-tel { margin-top: auto; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; color: var(--verde); white-space: nowrap; }
  .p-tel svg { flex: none; }
  /* Su telefono le schede sono due per riga: senza icona il numero sta su una riga sola */
  @media (max-width: 479px) {
    .p-tel svg { display: none; }
    .p-corpo { padding-inline: 12px; }
    /* Nomi lunghi vanno a capo: due righe riservate a tutti, schede alte uguali */
    .p-corpo h3 { line-height: 1.25; min-height: 2.5em; }
  }
  /* Sugli schermi più stretti "Ragazzi e Cadetti" va a capo: due righe per tutti */
  @media (max-width: 359px) { .p-tel { font-size: var(--fs-mini); } .p-gruppi { min-height: 2.4em; } }
</style>
