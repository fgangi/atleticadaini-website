---
import Carousel from './Carousel.astro';
import Contatore from './Contatore.astro';

/**
 * Sezione record della home: fondo verde del "tabellone", tre contatori e uno
 * scorrimento di schede bianche con i primati più importanti.
 * Ordine delle schede: l'ultimo record migliorato, il più longevo, poi quelli
 * con la spunta "In evidenza in home" nel pannello (nell'ordine delle tabelle).
 * Ogni scheda ha un'etichetta che racconta qualcosa: "Nuovo 2026" oppure
 * "Resiste da 64 anni".
 */
interface Props { record: any[]; titoli: any[] }
const { record, titoli } = Astro.props;
const annoCorrente = new Date().getFullYear();
const chi = (r: any) => r.atleta ?? (r.staffetta?.length ? r.staffetta.join(', ') : 'Staffetta');

const nRecord = record.length;
const nCampioni = titoli.filter((t) => t.tipo === 'campione').length;
const nAzzurri = titoli.filter((t) => t.tipo === 'azzurro').length;

// Il più recente per data (o anno); il più longevo fra gli assoluti all'aperto
const piuRecente = [...record].sort((a, b) => (b.anno ?? 0) - (a.anno ?? 0) || String(b.data ?? '').localeCompare(String(a.data ?? '')))[0];
const piuLongevo = record.filter((r) => r.categoria === 'assoluti' && (r.sezione ?? 'aperto') === 'aperto' && r.atleta)
  .sort((a, b) => (a.anno ?? 9999) - (b.anno ?? 9999))[0];
const inEvidenza = record.filter((r) => r.inEvidenza);

const primati = [piuRecente, piuLongevo, ...inEvidenza]
  // Niente doppioni: il più recente potrebbe essere anche in evidenza
  .filter((r, i, a) => r && a.findIndex((x) => x?._id === r._id) === i)
  .map((r: any) => ({ ...r,
    etichetta: r.anno === annoCorrente ? `Nuovo ${r.anno}` : `Resiste da ${annoCorrente - r.anno} anni`,
    genere: r.sesso === 'F' ? 'Femminile' : 'Maschile' }));
---
{primati.length > 0 && (
  <section class="section primati sfondo-scuro">
    <div class="container">
      <div class="section-head between">
        <div><span class="eyebrow">Record e campioni</span><h2>I nostri primati</h2></div>
        <a class="btn cta" href="/societa/record/">Tutti i record</a>
      </div>
      <ul class="pr-contatori">
        <li><strong><Contatore valore={nRecord} /></strong><span>record sociali</span></li>
        <li><strong><Contatore valore={nCampioni} /></strong><span>titoli conquistati</span></li>
        <li><strong><Contatore valore={nAzzurri} /></strong><span>presenze in maglia azzurra</span></li>
      </ul>
      <Carousel etichetta="Primati più importanti" allinea="stretch" larghezza="260px" larghezzaTablet="250px" larghezzaMobile="72vw">
        {primati.map((r: any) => (
          <article class:list={['pr-scheda', { nuovo: r.anno === annoCorrente }]}>
            <span class="pr-etichetta">{r.etichetta}</span>
            <span class="pr-spec">{r.specialita}<span class="pr-genere">{r.genere}</span></span>
            <span class="pr-prest tabnums">{r.prestazione}</span>
            <p class="pr-chi">{chi(r)}</p>
            <p class="pr-quando">{r.luogo ? `${r.luogo}, ${r.anno}` : r.anno}</p>
          </article>
        ))}
      </Carousel>
    </div>
  </section>
)}

<style>
  /* Fondo verde con le corsie: stacca la sezione dal resto della home */
  .primati { background: var(--sfondo-scuro); color: #fff; }
  .primati h2 { color: #fff; }
  .primati .eyebrow { color: var(--giallo); }
  .pr-contatori { list-style: none; margin: 0 0 clamp(24px, 3vw, 36px); padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .pr-contatori li { display: flex; flex-direction: column; border-top: 3px solid var(--giallo); padding-top: 10px; }
  .pr-contatori strong { font-family: var(--font-display); font-size: var(--fs-numero-grande); font-weight: 800; line-height: 1; color: var(--giallo); }
  .pr-contatori span { color: #D5DED3; font-size: var(--fs-testo-secondario); }
  @media (max-width: 639px) {
    .pr-contatori { gap: 10px; }
    .pr-contatori span { font-size: var(--fs-mini); line-height: 1.3; }
  }
  /* Schede bianche sul verde, come quelle della prima versione: si leggono meglio */
  .pr-scheda { display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 18px 20px;
    background: var(--ground); color: var(--ink); border-radius: var(--radius); border-top: 5px solid var(--verde); }
  .pr-scheda.nuovo { border-top-color: var(--giallo); }
  .pr-etichetta { align-self: flex-start; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .05em; font-weight: 700; font-size: var(--fs-mini);
    padding: .25rem .6rem; border-radius: 999px; background: var(--tinta); color: var(--verde); }
  .pr-scheda.nuovo .pr-etichetta { background: var(--giallo); color: var(--verde-scuro); }
  .pr-spec { margin-top: 8px; font-family: var(--font-display); text-transform: uppercase; font-weight: 800; font-size: var(--fs-titolo-scheda); line-height: 1.1; color: var(--verde); display: flex; flex-direction: column; }
  .pr-genere { font-size: var(--fs-mini); font-weight: 700; letter-spacing: .1em; color: var(--grigio-verde); }
  .pr-prest { font-family: var(--font-display); font-weight: 800; font-size: clamp(calc(var(--fs-numero) * 1.15), 3.6vw, calc(var(--fs-numero) * 1.4)); line-height: 1; color: var(--ink); margin-top: 4px; }
  .pr-chi { color: var(--ink); font-weight: 600; margin-top: auto; padding-top: 8px; }
  .pr-quando { color: var(--ink-soft); font-size: var(--fs-piccolo); }
</style>
