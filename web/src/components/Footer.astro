---
import Icona from './Icona.astro';
import { img, telHref, formatTel, whatsappHref, nomeRuolo } from '../lib/sanity';
import IconaWhatsApp from './IconaWhatsApp.astro';
import { logoRifilato, misuraLogo } from '../lib/loghi';
import SocialIcons from './SocialIcons.astro';
import Indirizzo from './Indirizzo.astro';

interface Props {
  settings: any;
  impianto?: { nome?: string; indirizzo?: string; ingresso?: string } | null;
  presenze: { album: number; record: number; team: number; collaborazioni?: number; storia: number; privacy: number; safeguarding: number; openDay?: boolean };
}
const { settings, impianto, presenze: p } = Astro.props;
const s = settings ?? {};
const nome = s.nome ?? 'Atletica Daini';
const anno = new Date().getFullYear();
const tuttiTelefoni: { nome?: string; ruolo?: string; numero: string; principale?: boolean }[] = s.telefoni ?? [];
// Il numero della società sta sopra, in giallo e con WhatsApp; i referenti sotto
const principali = tuttiTelefoni.filter((t) => t.principale);
const telefoni = tuttiTelefoni.filter((t) => !t.principale);
const sede = s.sede ? String(s.sede).replace(/\s*\n\s*/g, ', ') : null;

// Loghi istituzionali: margini vuoti tolti e stessa altezza per tutti,
// così un file con molto spazio attorno non appare più piccolo degli altri
const pid = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
const ds = import.meta.env.PUBLIC_SANITY_DATASET || 'production';
const enti = (await Promise.all((s.enti ?? []).map(async (e: any) => {
  const r = await logoRifilato(e.logo, pid, ds, 400);
  return r ? { ...e, src: r.url, stile: misuraLogo(r.prop, 80) } : null;
}))).filter(Boolean);

/**
 * Crediti del sito: una riga, ruolo e nome per esteso. Chi non ha ancora un
 * nome qui non compare: meglio una riga in meno che un segnaposto pubblicato.
 */
const CREDITI: { ruolo: string; nome: string; url?: string }[] = [
  { ruolo: 'Sito realizzato', nome: 'Francesco Gangi', url: 'https://github.com/fgangi' },
];

const conSocial = Object.values(s.social ?? {}).some((u) => typeof u === 'string' && u.startsWith('http'));
const identificativi = [
  s.codiceFiscale ? `C.F. ${s.codiceFiscale}` : null,
  s.partitaIva ? `P. IVA ${s.partitaIva}` : null,
  s.codiceFidal ? `Cod. FIDAL ${s.codiceFidal}` : null,
].filter(Boolean) as string[];
---
<footer class="site-footer sfondo-scuro">
  <div class="container">
    <div class="foot-grid">
      <!-- 1. Società: marchio, frase, social -->
      <div class="foot-brand">
        <a class="brand" href="/" aria-label={`${nome} – home`}>
          {/* Nel footer il logo degli 80 anni (1945-2025), versione per fondi scuri */}
          <img class="foot-logo" src="/loghi/logo-80-anni-chiaro.svg" alt="" width="170" height="100" />
        </a>
        {/* Frase breve sulla società; la descrizione lunga serve a Google, non qui */}
        <p class="foot-desc">{s.fraseFooter ?? `Società di atletica leggera di Carate Brianza, dal ${s.annoFondazione ?? 1945}.`}</p>
        {/* Come nel sito di riferimento: loghi istituzionali in una griglia a
            colonne uguali larga quanto il blocco, poi i social centrati */}
        {enti.length > 0 && (
          <div class="enti" style={`--n:${Math.min(enti.length, 3)}`}>
            {enti.map((e: any) => {
              const logo = <img src={e.src} alt={e.nome} style={e.stile} loading="lazy" />;
              return e.url ? <a href={e.url} target="_blank" rel="noopener">{logo}</a> : <span>{logo}</span>;
            })}
          </div>
        )}
        {conSocial && (
          <div class="foot-social">
            <p class="social-invito">Seguici sui social</p>
            <SocialIcons social={s.social} />
          </div>
        )}
      </div>

      <!-- 2. Naviga: le stesse voci del menu -->
      <div class="foot-naviga">
        <h4>Naviga</h4>
        <ul class="fnav">
          <li><a href="/societa/">Chi siamo</a></li>
          {p.team > 0 && <li><a href="/societa/team/">Team</a></li>}
          {p.collaborazioni > 0 && <li><a href="/societa/convenzioni/">Convenzioni</a></li>}
          <li><a href="/settore-giovanile/">Settore giovanile</a></li>
          {p.openDay && <li><a href="/open-days/">Open days</a></li>}
          <li><a href="/impianto/">Impianto</a></li>
          <li><a href="/news/">News</a></li>
          {p.album > 0 && <li><a href="/gallery/">Gallery</a></li>}
        </ul>
      </div>

      <!-- 3. Contatti e dove siamo -->
      <div>
        <h4>Contatti</h4>
        {/* Tre gruppi: telefoni vicini fra loro, poi l'email, poi il rimando alla pagina */}
        {principali.length > 0 && (
          <ul class="fnav contatti">
            {principali.map((t) => (
              <li><a class="tel-principale" href={whatsappHref(t.numero)} target="_blank" rel="noopener"><IconaWhatsApp size={18} /><span class="tabnums">{formatTel(t.numero)}</span><span class="tel-nome">{t.nome || 'WhatsApp'}</span></a></li>
            ))}
          </ul>
        )}
        {telefoni.length > 0 && (
          <ul class="fnav contatti">
            {telefoni.map((t) => (
              <li><a class="con-icona" href={telHref(t.numero)}><Icona nome="tel" size={18} /><span class="tabnums">{formatTel(t.numero)}</span>{t.nome && <span class="tel-nome">{nomeRuolo(t)}</span>}</a></li>
            ))}
          </ul>
        )}
        {s.email && <ul class="fnav contatti"><li><a class="con-icona" href={`mailto:${s.email}`}><Icona nome="mail" size={18} /><span>{s.email}</span></a></li></ul>}
        <a class="link-forte" href="/contatti/">Tutti i contatti →</a>
        {impianto?.indirizzo && (
          <div class="dove">
            <h4>Dove ci alleniamo</h4>
            <p><Indirizzo testo={impianto.nome ? `${impianto.nome}, ${String(impianto.indirizzo).replace(/\s*\n\s*/g, ', ')}` : impianto.indirizzo} nomeSuRiga /></p>
            {impianto.ingresso && <p class="nota">{impianto.ingresso}</p>}
            <a class="link-forte" href="/impianto/">Come arrivare →</a>
          </div>
        )}
      </div>
    </div>

    {/* 5×1000 tutto l'anno: striscia discreta sopra i dati legali, con il
        codice da copiare (la fascia grande in home si accende solo in stagione) */}
    {s.codiceFiscale && s.cinquePerMille?.striscia !== false && (
      <div class="f-cinque" data-copia-box>
        <div class="f5-testo">
          <span class="f5-tit">5×1000</span>
          <p>Sostieni i Daini: nella dichiarazione dei redditi firma nel riquadro delle associazioni sportive dilettantistiche e scrivi il nostro codice fiscale.</p>
        </div>
        <div class="f5-codice">
          <span class="f5-numero tabnums">{s.codiceFiscale}</span>
          <button type="button" class="btn chiaro f5-copia" data-copia={s.codiceFiscale} aria-label={`Copia il codice fiscale ${s.codiceFiscale}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
            <span data-copia-etichetta>Copia</span>
          </button>
          <span class="sr-only" data-copia-esito role="status" aria-live="polite"></span>
        </div>
      </div>
    )}

    <div class="foot-legale">
      {(s.denominazione || sede) && (
        <span>
          {s.denominazione && <strong>{s.denominazione}</strong>}
          {s.denominazione && sede && ' – '}
          {sede && <>Sede sociale: <Indirizzo testo={sede} /></>}
        </span>
      )}
      {/* Codice fiscale, partita IVA e codice FIDAL su una riga sola, separati da una lineetta */}
      {identificativi.length > 0 && <span class="f-id">{identificativi.map((x, i) => <>{i > 0 && <span class="f-sep" aria-hidden="true"> — </span>}<span class="tabnums">{x}</span></>)}</span>}
    </div>

    <div class="foot-bottom">
      <span>© {anno} {s.denominazione ?? nome}</span>
      <span class="foot-link">
        {p.privacy > 0 && <a href="/privacy/">Privacy e cookie</a>}
        {p.safeguarding > 0 && <a href="/safeguarding/">Safeguarding</a>}
        {CREDITI.map((c) => <span>{c.ruolo} da {c.url ? <a href={c.url} target="_blank" rel="noopener">{c.nome}</a> : c.nome}</span>)}
      </span>
    </div>
  </div>
</footer>

<style>
  /* Nessun margine sopra: dopo un blocco colorato restava una striscia bianca.
     Lo stacco lo fa il filetto giallo (come la barra del volantino); dopo un
     blocco bianco l'aria c'è già, nel margine interno della sezione */
  .site-footer { background: var(--sfondo-footer); color: #E8EDE6; border-top: 4px solid var(--giallo); }
  .site-footer a { color: #fff; }
  .foot-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .8fr) minmax(0, 1.1fr); gap: 40px; padding: 56px 0 36px; }
  /* Tablet: il marchio occupa da solo la prima riga, Naviga e Contatti affiancati sotto */
  @media (max-width: 1023px) {
    .foot-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px 28px; }
    .foot-brand { grid-column: 1 / -1; }
  }
  /* Telefono: una colonna sola */
  @media (max-width: 639px) { .foot-grid { grid-template-columns: minmax(0, 1fr); gap: 30px; padding-top: 44px; } }

  /* Blocco del marchio largo al massimo 360px: loghi e social si allineano
     tutti alla stessa larghezza, come nel sito di riferimento */
  .foot-brand { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; width: min(100%, 360px); }
  .foot-brand > .enti, .foot-brand > .foot-social { width: 100%; }
  /* Loghi a colonne uguali, direttamente sul verde, nella versione per fondi
     scuri caricata nel pannello (scritte bianche, tricolore a colori): senza
     riquadri possono essere più grandi e leggibili */
  .enti { margin-top: 10px; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 16px; align-items: center; }
  .enti > * { display: flex; align-items: center; justify-content: center; min-height: 44px; transition: opacity .12s ease; }
  .enti a:hover { opacity: .85; }
  .enti img { height: var(--lh); width: var(--lw); max-width: 100%; object-fit: contain; }
  /* Social sotto una riga sottile, centrati sulla larghezza del blocco */
  .foot-social { display: flex; flex-direction: column; align-items: center; gap: 12px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, .2); }
  .social-invito { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-weight: 700; font-size: var(--fs-etichetta); color: #fff; }
  .foot-social :global(.social-icons) { justify-content: center; gap: 12px; }
  .brand { display: inline-flex; min-height: 44px; align-items: center; color: #fff; }
  /* Logo grande e centrato: riempie la colonna come i loghi e i social sotto */
  .foot-logo { height: 116px; width: auto; max-width: 100%; object-fit: contain; }
  /* La frase sta vicina al logo Daini (ne fa parte) e staccata dai loghi
     istituzionali sotto. Il file del logo ha ~18px vuoti sotto la scritta:
     il margine negativo li recupera, e la frase resta a ~10px dalle lettere */
  .foot-desc { margin-top: -4px; color: #C9D2C8; max-width: 46ch; font-size: var(--fs-footer); line-height: 1.5; text-wrap: pretty; }
  .site-footer h4 { font-size: calc(var(--fs-footer-piccolo) * 1.08); letter-spacing: .14em; font-weight: 700; margin: 0 0 12px; color: var(--giallo); }
  .fnav { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  /* Ogni link del footer è alto 44px: vicini e più bassi, sul telefono si toccava quello accanto */
  .fnav a { display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .03em; font-size: var(--fs-footer-link); font-weight: 600; opacity: .88; }
  .fnav a:hover { opacity: 1; color: var(--giallo); }
  /* Email e numeri restano in caso normale: in maiuscolo un indirizzo si legge male */
  .fnav.contatti a { font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-size: var(--fs-footer); font-weight: 500; overflow-wrap: anywhere; }
  .fnav.contatti + .fnav.contatti { margin-top: 12px; }
  /* Su PC (col mouse) le righe dei contatti stanno vicine; su telefono e
     tablet restano da 44px, altrimenti si tocca il numero accanto */
  @media (min-width: 1024px) { .fnav.contatti a { min-height: 32px; } }
  /* Su PC le voci di "Naviga" hanno righe da 44px e i contatti da 32px: senza
     questo "Chi siamo" partirebbe 5px più in basso del numero WhatsApp accanto */
  /* Su PC le voci di "Naviga" hanno righe da 36px: più raccolte, e la prima
     lettera di "Chi siamo" cade alla stessa altezza del numero WhatsApp accanto
     (misurato sui pixel: i due caratteri hanno altezze diverse) */
  /* Su PC la colonna "Naviga" è alta quanto "Contatti" e le voci si distribuiscono
     a distanze uguali: la prima cade all'altezza del numero WhatsApp, l'ultima di
     "Come arrivare" (misurato sui pixel), qualunque sia il numero di voci */
  @media (min-width: 1024px) {
    .foot-naviga { display: flex; flex-direction: column; }
    .fnav:not(.contatti) { flex: 1; justify-content: space-between; margin-top: -1px; padding-bottom: 5px; }
    .fnav:not(.contatti) a { min-height: 36px; }
  }
  .nota { opacity: .7; }
  /* Numero in bianco e nome in grigio: bastano colore e spazio a separarli */
  .tel-nome { margin-left: .7em; color: #B9C4B8; }
  /* Telefoni ed email con l'icona a sinistra, come il numero WhatsApp: testi allineati in colonna */
  .fnav.contatti a.tel-principale, .fnav.contatti a.con-icona { gap: 8px; }
  .fnav.contatti a.tel-principale { color: var(--giallo); font-weight: 700; }
  .con-icona .tel-nome { margin-left: .2em; }
  /* Il numero resta su una riga; sui telefoni stretti va a capo il nome */
  .fnav.contatti .tabnums { flex: none; white-space: nowrap; }
  .fnav.contatti .tel-nome { min-width: 0; line-height: 1.3; }
  .tel-principale .tel-nome { margin-left: 0; font-weight: 500; }
  .dove { margin-top: 18px; }
  .dove p { color: #E8EDE6; font-size: var(--fs-footer); line-height: 1.5; }
  .dove .nota { font-size: var(--fs-footer-piccolo); margin-top: 4px; }
  /* Rimandi alle pagine (Tutti i contatti, Come arrivare): in grassetto, per
     distinguerli dalle righe di dati */
  .link-forte { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; font-weight: 700; opacity: .92; }
  .link-forte:hover { opacity: 1; color: var(--giallo); }


  .foot-legale { border-top: 1px solid rgba(255, 255, 255, .14); padding: 16px 0 4px;
    display: flex; flex-direction: column; gap: 4px; font-size: var(--fs-footer-piccolo); color: #B9C4B8; line-height: 1.5; }
  .foot-legale strong { font-weight: 600; color: #E8EDE6; }
  /* Se non ci stanno su una riga (telefono) vanno a capo interi, mai a metà */
  .f-id .tabnums { white-space: nowrap; }
  .f-sep { opacity: .6; }
  /* Stesso riquadro della fascia 5×1000 in home, in piccolo */
  .f-cinque { margin: 8px 0 20px; padding: 14px 20px; border-radius: var(--radius);
    background: rgba(244, 246, 173, .08); border: 1px solid rgba(244, 246, 173, .25);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 28px; }
  .f5-testo { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 14px; min-width: 0; }
  .f5-tit { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-titolo-scheda); letter-spacing: .02em; color: var(--giallo); }
  .f5-testo p { color: #D5DED3; font-size: var(--fs-footer); }
  .f5-codice { display: flex; align-items: center; gap: 14px; }
  .f5-numero { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-numero-piccolo); letter-spacing: .05em; color: #fff; }
  /* Larghezza fissa: passando da "Copia" a "Copiato" il pulsante non cambia misura */
  .f5-copia { min-height: 44px; min-width: 7.5rem; padding: 0 1rem; gap: 6px; font-size: var(--fs-piccolo); }
  @media (max-width: 639px) {
    .f-cinque { padding: 14px 16px; }
    .f5-codice { width: 100%; justify-content: space-between; }
  }
  .foot-bottom { padding: 8px 0 20px; font-size: var(--fs-footer-piccolo); color: #B9C4B8; display: flex; align-items: center;
    justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; }
  .foot-link { display: flex; flex-wrap: wrap; gap: 0 18px; }
  .foot-link a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 2px; color: #E8EDE6; }
</style>
