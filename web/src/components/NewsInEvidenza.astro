---
import { img, formatData, posizione } from '../lib/sanity';

/** Scheda grande dell'articolo in evidenza, usata in home. */
interface Props { item: any; }
const { item } = Astro.props;
const cover = img(item.copertina, 1100);
const pos = posizione(item.posizioneAnteprima);
---
<a class="featured card" href={`/news/${item.slug}/`}>
  <div class="f-media">
    {cover ? <img src={cover} alt="" style={`object-position:${pos}`} /> : <div class="thumb-ph" aria-hidden="true"></div>}
  </div>
  <div class="f-body">
    <span class="pill">In evidenza</span>
    <span class="tag">{formatData(item.data)}</span>
    <h3>{item.titolo}</h3>
    {item.estratto && <p>{item.estratto}</p>}
    <span class="more" aria-hidden="true">Leggi l'articolo →</span>
  </div>
</a>
<style>
  .featured { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: stretch;
    transition: transform .14s ease, border-color .14s ease; }
  .featured:hover { transform: translateY(-3px); border-color: var(--salvia); }
  /* width:100% ancora la larghezza alla colonna: senza, con lo stretch
     aspect-ratio ricalcola la larghezza dall'altezza e l'immagine invade il testo */
  .f-media { position: relative; background: var(--surface-2); overflow: hidden; width: 100%; aspect-ratio: 16 / 10; align-self: stretch; }
  .f-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .f-media .thumb-ph { width: 100%; height: 100%; background: var(--sfondo-scuro); }
  .f-body { padding: clamp(18px, 2.6vw, 34px); display: flex; flex-direction: column; gap: 10px; align-items: flex-start; justify-content: center; }
  .f-body h3 { font-size: clamp(1.3rem, 2vw, 1.7rem); color: var(--ink);
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .f-body p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .f-body .more { margin-top: 6px; }
  @media (max-width: 1023px) { .featured { grid-template-columns: minmax(0, 1fr); } }
</style>
