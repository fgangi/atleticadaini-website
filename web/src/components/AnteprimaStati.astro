---
/**
 * Barra di anteprima — SOLO IN SVILUPPO (esclusa dalla build pubblicata).
 *
 * Mostra come apparirà il sito in situazioni che nel pannello non sono ancora
 * vere: per ora iscrizioni aperte o chiuse. Non tocca i dati: cambia solo ciò
 * che si vede in questo browser. Per un'anteprima nuova basta una riga con
 * data-gruppo e, negli elementi interessati, data-sim-<gruppo>="<valore>".
 */
---
<div class="anteprima" data-anteprima>
  <button class="ap-tab" type="button" data-ap-toggle aria-expanded="false">
    <span class="ap-punto" aria-hidden="true"></span>Anteprima stati
  </button>
  <div class="ap-corpo" hidden>
    <div class="ap-riga" data-gruppo="iscrizioni">
      <span class="ap-tit">Iscrizioni</span>
      <button type="button" data-v="reale" aria-pressed="true">Reale</button>
      <button type="button" data-v="aperte" aria-pressed="false">Aperte</button>
      <button type="button" data-v="chiuse" aria-pressed="false">Chiuse</button>
    </div>
    <p class="ap-nota">Solo in sviluppo: i dati del pannello non vengono modificati.</p>
  </div>
</div>

<style is:global>
  .anteprima { position: fixed; right: 14px; bottom: 14px; z-index: 9999;
    display: flex; flex-direction: column; align-items: flex-end; gap: 8px; max-width: calc(100vw - 28px);
    font-family: system-ui, sans-serif; }
  .ap-tab { display: inline-flex; align-items: center; gap: 7px; min-height: 36px;
    background: rgba(20, 28, 23, .94); color: #fff; border: 0; padding: .45rem .85rem;
    border-radius: 999px; font-size: .78rem; font-weight: 650; cursor: pointer; box-shadow: 0 8px 30px rgba(0, 0, 0, .3); }
  .ap-punto { width: .5rem; height: .5rem; border-radius: 50%; background: var(--giallo); }
  .ap-corpo { background: rgba(20, 28, 23, .96); color: #fff; border-radius: 14px; padding: 12px 14px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, .35); display: flex; flex-direction: column; gap: 12px; max-width: 100%; }
  .ap-riga { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .ap-riga[hidden] { display: none; }
  .ap-tit { text-transform: uppercase; letter-spacing: .1em; font-size: .62rem; opacity: .6; font-weight: 700; width: 100%; }
  .ap-corpo button { color: #fff; background: transparent; border: 1px solid rgba(255, 255, 255, .25); border-radius: 999px;
    padding: .3rem .65rem; font-size: .78rem; font-weight: 600; white-space: nowrap; cursor: pointer; font-family: inherit; }
  .ap-corpo button:hover { background: rgba(255, 255, 255, .12); }
  .ap-corpo button[aria-pressed='true'] { background: var(--giallo); color: var(--verde-scuro); border-color: transparent; }
  .ap-nota { margin: 0; font-size: .7rem; opacity: .55; max-width: 300px; color: #fff; }
</style>

<script is:inline>
  (() => {
    const avvia = () => {
      const box = document.querySelector('[data-anteprima]');
      if (!box || box.dataset.pronto) return;
      box.dataset.pronto = '1';
      const tab = box.querySelector('[data-ap-toggle]');
      const corpo = box.querySelector('.ap-corpo');
      const leggi = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
      const scrivi = (k, v) => { try { localStorage.setItem(k, v); } catch {} };

      const mostraPannello = (v) => {
        corpo.hidden = !v;
        tab.setAttribute('aria-expanded', String(v));
        scrivi('ap_aperta', v ? '1' : '0');
      };

      /**
       * Ogni elemento che dipende da uno stato porta data-sim-<gruppo>="<valore>"
       * e data-reale (se è quello visibile davvero): si mostra quello scelto.
       */
      const applicaVarianti = (gruppo, v) => {
        document.querySelectorAll(`[data-sim-${gruppo}]`).forEach((el) => {
          if (el.dataset.realeHidden === undefined) el.dataset.realeHidden = el.hidden ? '1' : '0';
          el.hidden = v === 'reale' ? el.dataset.realeHidden === '1' : el.getAttribute(`data-sim-${gruppo}`) !== v;
        });
      };
      const applica = (gruppo, v) => {
        scrivi('ap_' + gruppo, v);
        box.querySelectorAll(`[data-gruppo="${gruppo}"] button`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
        // Le prove che valgono per tutta la pagina (data-su-html): attributo su <html>
        if (box.querySelector(`[data-gruppo="${gruppo}"]`)?.hasAttribute('data-su-html')) {
          if (v === 'reale') delete document.documentElement.dataset['ap' + gruppo[0].toUpperCase() + gruppo.slice(1)];
          else document.documentElement.dataset['ap' + gruppo[0].toUpperCase() + gruppo.slice(1)] = v;
        } else applicaVarianti(gruppo, v);
      };

      box.querySelectorAll('[data-solo]').forEach((r) => { r.hidden = location.pathname !== r.dataset.solo; });
      box.querySelectorAll('[data-gruppo]').forEach((riga) => {
        const gruppo = riga.dataset.gruppo;
        riga.querySelectorAll('button').forEach((b) => { b.onclick = () => applica(gruppo, b.dataset.v); });
        // La scelta resta fra una pagina e l'altra: si sta confrontando
        applica(gruppo, leggi('ap_' + gruppo) || 'reale');
      });
      mostraPannello(leggi('ap_aperta') === '1');
      tab.onclick = () => mostraPannello(corpo.hidden);
    };
    avvia();
    // Dopo una transizione la barra è nuova: si riapplicano le scelte
    document.addEventListener('astro:page-load', avvia);
  })();
</script>
