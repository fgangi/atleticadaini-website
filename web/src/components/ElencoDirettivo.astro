---
import { telHref, formatTel } from '../lib/sanity';

/**
 * Consiglio direttivo come elenco semplice (carica, nome, telefono): è
 * un'informazione istituzionale, le schede con le foto restano agli
 * allenatori. Chi allena ed è anche nel consiglio ha così una sola scheda.
 */
interface Props { membri: any[] }
const { membri } = Astro.props;
---
<ul class="direttivo">
  {membri.map((m) => (
    <li>
      <span class="d-carica">{m.ruolo}</span>
      <span class="d-nome">{m.nome}</span>
      {m.telefono && <a class="d-tel tabnums" href={telHref(m.telefono)} aria-label={`Chiama ${m.nome}: ${formatTel(m.telefono)}`}>{formatTel(m.telefono)}</a>}
    </li>
  ))}
</ul>
<style>
  .direttivo { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 760px; }
  .direttivo li { display: grid; grid-template-columns: 11rem minmax(0, 1fr) auto; align-items: center; gap: 4px 16px;
    padding: 10px 18px; background: var(--ground); border: 1px solid var(--line); border-radius: 12px; }
  .d-carica { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-weight: 700; color: var(--verde); }
  .d-nome { font-weight: 700; color: var(--ink); font-size: var(--fs-testo); }
  .d-tel { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--verde); white-space: nowrap; }
  /* Telefono: carica sopra, nome e numero sotto */
  @media (max-width: 639px) {
    .direttivo li { grid-template-columns: minmax(0, 1fr) auto; }
    .d-carica { grid-column: 1 / -1; }
  }
</style>
