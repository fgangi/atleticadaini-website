---
import { mapEmbedSrc } from '../lib/sanity';

/**
 * Mappa di Google incorporata, visibile subito (si carica quando arriva
 * vicino allo schermo). Le indicazioni stradali sono un pulsante a parte,
 * nel testo accanto. La mappa usa i cookie di Google senza banner di consenso:
 * scelta della società (2026-10-07), spiegata nell'informativa privacy.
 */
interface Props { posizione?: string | null; indirizzo?: string | null; titolo: string }
const { posizione, indirizzo, titolo } = Astro.props;
const src = mapEmbedSrc(posizione || indirizzo);
---
{src && (
  <div class="mappa">
    <iframe src={src} loading="lazy" title={`Mappa: ${titolo}`} allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
)}
<style>
  .mappa { position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); min-height: 300px; height: 100%;
    background: var(--sfondo-chiaro); line-height: 0; }
  .mappa iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
