---
import { ritaglio } from '../lib/sanity';
import { PAGINA_FOTO } from '../lib/formati';

/**
 * Intestazione delle pagine interne: fascia verde con il motivo delle corsie.
 * Con `foto` la foto fa da sfondo alla fascia, sotto un velo verde.
 */
interface Props { eyebrow?: string; title: string; lead?: string | null; foto?: any; }
const { eyebrow, title, lead, foto } = Astro.props;
const pc = ritaglio(foto, PAGINA_FOTO.pc, [1280, 1600, 2000, 2400]);
const piccola = ritaglio(foto, PAGINA_FOTO.telefono, [640, 960, 1280]);
---
<section class:list={['page-hero sfondo-scuro', { 'con-foto': pc && piccola }]}>
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  {pc && piccola && (
    <picture class="ph-foto">
      <source media="(min-width: 1024px)" srcset={pc.srcset} sizes="100vw" />
      <img src={piccola.src} srcset={piccola.srcset} sizes="100vw" alt={foto.alt ?? ''} fetchpriority="high" />
    </picture>
  )}
</section>
<style>
  .page-hero { background: var(--sfondo-scuro); color: #fff; padding: clamp(40px, 7vw, 84px) 0 clamp(36px, 5vw, 60px); }
  /* Colonna flex: fra occhiello e titolo la stessa distanza delle intestazioni di sezione */
  .page-hero .container { display: flex; flex-direction: column; align-items: flex-start; gap: var(--stacco-occhiello); }
  .page-hero .eyebrow { margin: 0; color: var(--giallo); }
  .page-hero h1 { color: #fff; }
  .page-hero .lead { max-width: 60ch; margin: 12px 0 0; color: #E3EAE1; }

  /* La foto riempie la fascia dietro al testo; il velo verde tiene leggibili le scritte:
     su PC più scuro a sinistra (dove sta il testo), su tablet e telefono uniforme */
  .con-foto { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center;
    min-height: min(calc(100vw * 1.25), 620px); }
  .ph-foto { position: absolute; inset: 0; z-index: -1; }
  .ph-foto img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 75%; display: block; }
  .ph-foto::after { content: ""; position: absolute; inset: 0; background: rgba(16, 55, 38, .68); }
  .con-foto .container { width: 100%; }
  @media (min-width: 640px) { .con-foto { min-height: min(calc(100vw / 1.6), 560px); } }
  @media (min-width: 1024px) {
    .con-foto { min-height: min(calc(100vw / 2.4), 680px); }
    .ph-foto::after { background: linear-gradient(90deg, rgba(16, 55, 38, .92) 0%, rgba(16, 55, 38, .8) 45%, rgba(16, 55, 38, .2) 100%); }
  }
</style>
