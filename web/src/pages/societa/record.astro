---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { sfetch } from '../../lib/sanity';
import { recordQuery, titoliQuery } from '../../lib/queries';
import { CATEGORIE_RECORD, SEZIONI_RECORD } from '../../sanity/schemaTypes/record';
import { TIPI_TITOLO } from '../../sanity/schemaTypes/titolo';

/**
 * Record sociali per categoria, poi campioni italiani e maglie azzurre.
 * Senza JavaScript tutte le categorie sono una sotto l'altra; con JavaScript
 * i pulsanti in alto ne mostrano una alla volta (l'indirizzo resta
 * condivisibile: /societa/record/?categoria=allievi).
 */
const [record, titoli] = await Promise.all([
  sfetch<any[]>(recordQuery, {}, []),
  sfetch<any[]>(titoliQuery, {}, []),
]);
const annoCorrente = new Date().getFullYear();
const categorie = CATEGORIE_RECORD.map((c) => ({
  ...c,
  // Per sesso, e dentro ciascuno le sezioni come nelle tabelle storiche
  gruppi: [
    { sesso: 'M', titolo: 'Maschili' },
    { sesso: 'F', titolo: 'Femminili' },
  ].map((g) => ({
    ...g,
    sezioni: SEZIONI_RECORD.map((z) => ({
      ...z,
      righe: record.filter((r) => r.categoria === c.value && r.sesso === g.sesso && (r.sezione ?? 'aperto') === z.value),
    })).filter((z) => z.righe.length > 0),
  })).filter((g) => g.sezioni.length > 0),
})).filter((c) => c.gruppi.length > 0);
const tipiTitolo = TIPI_TITOLO.map((t) => ({ ...t, voci: titoli.filter((x) => x.tipo === t.value) })).filter((t) => t.voci.length > 0);
const chi = (r: any) => r.atleta ?? (r.staffetta?.length ? r.staffetta.join(', ') : '');
// La data esatta se c'è, altrimenti l'anno (molti record storici hanno solo quello)
const quando = (r: any) => r.data ? new Date(r.data).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' }) : String(r.anno ?? '');
const titoloTipo: Record<string, string> = { campione: 'I nostri campioni', azzurro: 'Maglie azzurre' };
// Albo d'oro come linea del tempo: le voci (già in ordine dal più recente) divise per decennio
const perDecennio = (voci: any[]) => {
  const m = new Map<number, any[]>();
  for (const v of voci) { const d = Math.floor(v.anno / 10) * 10; m.set(d, [...(m.get(d) ?? []), v]); }
  return [...m.entries()].sort((a, b) => b[0] - a[0])
    .map(([d, lista]) => ({ etichetta: d >= 2000 ? `Anni ${d}` : `Anni '${String(d).slice(-2)}`, lista }));
};
---
<Layout title="Record" description="Record sociali dell'Atletica Daini per categoria, campioni italiani e maglie azzurre.">
  <PageHero eyebrow="Albo della società" title="Record" lead="I migliori risultati di sempre ottenuti da atlete e atleti dei Daini." />

  {categorie.length > 0 && (
    <section class="section">
      <div class="container" data-record>
        <div class="filtri" role="group" aria-label="Categoria" data-filtri hidden>
          {categorie.map((c, n) => (
            <button type="button" class="filtro" data-cat={c.value} aria-pressed={n === 0 ? 'true' : 'false'}>{c.title}</button>
          ))}
        </div>
        <p class="legenda"><span class="campione" aria-hidden="true"></span>Evidenziati i record migliorati nel {annoCorrente}</p>

        {categorie.map((c) => (
          <div class="categoria" data-categoria={c.value}>
            <div class="section-head" id={c.value}><span class="eyebrow">Record sociali</span><h2>{c.title}</h2></div>
            {c.gruppi.map((g) => (
              <div class="gruppo">
                <h3 class="g-titolo">{g.titolo}</h3>
                {g.sezioni.map((z) => {
                  // Colonne senza dati in tutta la tabella (es. luogo nei record storici) non si mostrano
                  const conLuogo = z.righe.some((r) => r.luogo);
                  const tabella = (
                    <table class="tabella tabella-record">
                      <thead><tr><th>Specialità</th><th class="num">Prestazione</th><th>Atleta</th><th class="num">Nato / età</th><th class="num">Data</th>{conLuogo && <th>Luogo</th>}</tr></thead>
                      <tbody>
                        {z.righe.map((r) => (
                          <tr class:list={{ evidenziata: r.anno === annoCorrente }}>
                            <td class="c-spec">{r.specialita}</td>
                            <td class="num c-prest">{r.prestazione}</td>
                            <td class="c-atleta">{chi(r)}</td>
                            <td class="num c-info">{r.annoNascita ? <><span class="solo-tel">nato nel </span>{r.annoNascita}</> : (r.eta ? `${r.eta} anni` : '')}</td>
                            <td class="num c-info">{quando(r)}</td>
                            {conLuogo && <td class="c-info">{r.luogo ?? ''}</td>}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  );
                  // All'aperto sempre visibile; indoor e non olimpiche a scomparsa: tutto
                  // resta consultabile, ma la pagina non diventa lunghissima sul telefono
                  return z.value === 'aperto' ? (
                    <>{g.sezioni.length > 1 && <h4 class="z-titolo">{z.title}</h4>}{tabella}</>
                  ) : (
                    <details class="z-det">
                      <summary class="z-titolo">{z.title} <span class="z-n">{z.righe.length} record</span></summary>
                      {tabella}
                    </details>
                  );
                })}
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  {tipiTitolo.map((t) => (
    <section class="section fascia-tenue">
      <div class="container">
        <div class="section-head" id={t.value}><span class="eyebrow">Albo d'oro</span><h2>{titoloTipo[t.value] ?? t.title}</h2></div>
        <div class="tempo">
          {perDecennio(t.voci).map((d) => (
            <div class="decennio">
              <h3 class="dec-titolo">{d.etichetta}</h3>
              <ol class="dec-lista">
                {d.lista.map((v) => (
                  <li>
                    <span class="t-anno tabnums">{v.anno}</span>
                    <strong class="t-atleta">{v.atleta}</strong>
                    {(v.risultato || v.gara) && <span class="t-risultato">{v.risultato}{v.risultato && v.gara && ' '}{v.gara && <span class="t-gara">{v.gara}</span>}</span>}
                    {(v.manifestazione || v.nota) && <span class="t-dove">{v.manifestazione}{v.nota && <span class="t-nota">{v.manifestazione && ' '}({v.nota})</span>}</span>}
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  {categorie.length === 0 && tipiTitolo.length === 0 && (
    <section class="section"><div class="container"><div class="empty"><strong>Record non ancora inseriti</strong>Si compilano nel pannello, alla voce "Record sociali".</div></div></section>
  )}
</Layout>

<style>
  .filtri { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .filtro { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.1rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line); background: var(--ground); color: var(--verde);
    font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-weight: 700; font-size: var(--fs-etichetta); }
  .filtro:hover { border-color: var(--verde); }
  .filtro[aria-pressed='true'] { background: var(--verde); color: #fff; border-color: transparent; }
  .legenda { display: flex; align-items: center; gap: 8px; font-size: var(--fs-piccolo); margin-bottom: clamp(20px, 3vw, 32px); }
  .legenda .campione { width: 22px; height: 14px; border-radius: 3px; background: var(--tinta); border: 1px solid var(--giallo); }
  .categoria + .categoria { margin-top: clamp(40px, 6vw, 64px); }
  .gruppo + .gruppo { margin-top: 36px; }
  .z-titolo { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .05em; font-size: var(--fs-etichetta); font-weight: 700; color: var(--verde); margin: 22px 0 6px; }
  .gruppo .tabella + .z-titolo { margin-top: 30px; }
  .g-titolo { font-family: var(--font-display); text-transform: uppercase; font-size: calc(var(--fs-titolo-scheda) * 1.12); font-weight: 800; color: var(--grigio-verde); margin-bottom: 8px; }
  /* La prestazione è il dato principale: grande e condensata come su un tabellone */
  .c-prest { font-family: var(--font-display); font-size: var(--fs-titolo-scheda); font-weight: 800; color: var(--verde); }
  .c-spec { font-weight: 700; color: var(--ink); }
  .solo-tel { display: none; }
  .z-det { margin-top: 18px; border-top: 1px solid var(--line); }
  .z-det summary { cursor: pointer; display: flex; align-items: center; gap: 10px; min-height: 48px; margin: 0; list-style: none; }
  .z-det summary::-webkit-details-marker { display: none; }
  .z-det summary::before { content: '+'; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
    background: var(--surface-2); color: var(--verde); font-family: var(--font-body); font-weight: 700; }
  .z-det[open] summary::before { content: '–'; }
  .z-n { font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-weight: 500; font-size: var(--fs-piccolo); color: var(--ink-faint); }
  /* Telefono: una riga compatta per record, al posto della scheda con le
     etichette. Specialità e prestazione in alto, atleta e dettagli sotto. */
  @media (max-width: 639px) {
    .tabella-record tr { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; column-gap: 6px; row-gap: 2px;
      padding: 10px 2px; margin: 0; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; background: none; }
    .tabella-record tr.evidenziata { background: var(--tinta); border-color: var(--giallo); padding-inline: 8px; }
    .tabella-record td { display: block; padding: 0; border: 0; text-align: left; }
    .tabella-record td::before { content: none; }
    /* Tre righe: specialità / atleta / nato · data · luogo; la prestazione a destra */
    .tabella-record .c-spec { grid-column: 1 / 4; grid-row: 1; font-size: var(--fs-testo-secondario); }
    .tabella-record .c-prest { grid-column: 4; grid-row: 1 / span 3; align-self: center; font-size: var(--fs-numero-piccolo); padding-left: 8px; }
    .tabella-record .c-atleta { grid-column: 1 / 4; grid-row: 2; color: var(--ink-soft); }
    .tabella-record .c-info { grid-row: 3; font-size: var(--fs-piccolo); color: var(--ink-faint); white-space: nowrap; }
    .tabella-record .c-info:last-child { white-space: normal; }
    .tabella-record .c-info:empty { display: none; }
    .tabella-record .c-info:not(:empty) ~ .c-info:not(:empty)::before { content: ', '; }
    .solo-tel { display: inline; }
  }
  /* Albo d'oro: linea del tempo. Decennio a sinistra, una riga per risultato
     lungo una linea gialla con un pallino per anno */
  .tempo { display: grid; gap: 28px; }
  .decennio { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 24px; }
  .dec-titolo { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-numero); color: var(--verde); line-height: 1; padding-top: 8px; }
  .dec-lista { list-style: none; margin: 0; padding: 0 0 0 22px; border-left: 3px solid var(--giallo); }
  .dec-lista li { position: relative; display: grid; grid-template-columns: 3.4rem minmax(0, 14rem) minmax(0, 1fr); column-gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .dec-lista li::before { content: ""; position: absolute; left: -30px; top: 17px; width: 13px; height: 13px; border-radius: 50%; background: var(--verde); border: 3px solid var(--surface); }
  .t-anno { grid-row: 1 / 3; font-family: var(--font-display); font-weight: 800; font-size: var(--fs-testo-grande); color: var(--verde); }
  .t-atleta { grid-row: 1 / 3; font-weight: 700; color: var(--ink); }
  .t-risultato { grid-column: 3; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .03em; font-weight: 800; color: var(--verde); font-size: var(--fs-etichetta); }
  /* Le unità restano minuscole (m, km): in maiuscolo "M" vorrebbe dire mega */
  .t-gara { color: var(--ink); text-transform: none; letter-spacing: 0; font-family: var(--font-body); font-weight: 700; }
  .t-dove { grid-column: 3; color: var(--ink-soft); font-size: var(--fs-testo-secondario); }
  .t-nota { color: var(--ink-faint); }
  /* Telefono: decennio sopra, poi anno a sinistra e il resto impilato a destra */
  @media (max-width: 639px) {
    .decennio { grid-template-columns: 1fr; gap: 10px; }
    .dec-titolo { font-size: var(--fs-numero-piccolo); padding-top: 0; }
    .dec-lista { padding-left: 18px; }
    .dec-lista li { grid-template-columns: 3rem minmax(0, 1fr); }
    .dec-lista li::before { left: -26px; }
    .t-atleta { grid-row: auto; grid-column: 2; }
    .t-risultato, .t-dove { grid-column: 2; }
  }
</style>

<script is:inline>
  (() => {
    const avvia = () => {
      const box = document.querySelector('[data-record]');
      if (!box || box.dataset.pronto) return;
      box.dataset.pronto = '1';
      const filtri = box.querySelector('[data-filtri]');
      const bottoni = [...box.querySelectorAll('.filtro')];
      // Una categoria sola: i pulsanti non servono
      if (bottoni.length < 2) return;
      filtri.hidden = false;
      const applica = (cat, aggiornaUrl) => {
        box.querySelectorAll('[data-categoria]').forEach((el) => { el.hidden = el.dataset.categoria !== cat; });
        bottoni.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
        if (aggiornaUrl) {
          const u = new URL(location.href);
          u.searchParams.set('categoria', cat);
          history.replaceState(null, '', u);
        }
      };
      bottoni.forEach((b) => { b.onclick = () => applica(b.dataset.cat, true); });
      const iniziale = new URL(location.href).searchParams.get('categoria');
      applica(bottoni.some((b) => b.dataset.cat === iniziale) ? iniziale : bottoni[0].dataset.cat, false);
    };
    avvia();
    document.addEventListener('astro:page-load', avvia);
  })();
</script>
