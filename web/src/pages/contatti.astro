---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Indirizzo from '../components/Indirizzo.astro';
import SocialIcons from '../components/SocialIcons.astro';
import IconaWhatsApp from '../components/IconaWhatsApp.astro';
import Mappa from '../components/Mappa.astro';
import { sfetch, telHref, formatTel, indicazioniUrl, whatsappHref, nomeRuolo } from '../lib/sanity';
import { settingsQuery, impiantiQuery } from '../lib/queries';

/**
 * Contatti a blocchi, dal più usato al meno usato:
 *  1. Chiamaci o scrivici: pulsanti grandi, comodi da toccare
 *  2. Dove siamo: campo (allenamenti) e sede sociale
 *  3. Link utili e social
 *  4. Dati societari, in piccolo
 * Ogni voce compare solo se il dato c'è nel pannello: niente righe vuote.
 */
const [s, impianti] = await Promise.all([sfetch<any>(settingsQuery, {}, null), sfetch<any[]>(impiantiQuery, {}, [])]);
// Il numero della società (WhatsApp) va in evidenza, i referenti sotto
const principali: any[] = (s?.telefoni ?? []).filter((t: any) => t.principale);
const telefoni: any[] = (s?.telefoni ?? []).filter((t: any) => !t.principale);
const campo = impianti[0];
const sede = s?.sede ? String(s.sede).replace(/\s*\n\s*/g, ', ') : null;
const conSocial = Object.values(s?.social ?? {}).some((u) => typeof u === 'string' && u.startsWith('http'));
const dati = [
  s?.denominazione ? { dt: 'Denominazione', dd: s.denominazione } : null,
  sede ? { dt: 'Sede sociale', dd: sede } : null,
  s?.codiceFiscale ? { dt: 'Codice fiscale', dd: s.codiceFiscale } : null,
  s?.partitaIva ? { dt: 'Partita IVA', dd: s.partitaIva } : null,
  s?.codiceFidal ? { dt: 'Codice FIDAL', dd: s.codiceFidal } : null,
].filter(Boolean) as { dt: string; dd: string }[];
---
<Layout title="Contatti" description="Contatti dell'Atletica Daini: telefoni, email, campo di allenamento e sede a Carate Brianza.">
  <PageHero eyebrow="Siamo qui" title="Contatti" lead="Chiamaci, scrivici o passa al campo prima o dopo gli allenamenti." />

  <section class="section">
    <div class="container contatti">
      {(principali.length > 0 || telefoni.length > 0 || s?.email) && (
        <div class="card blocco">
          <h2 class="blocco-titolo">Chiamaci o scrivici</h2>
          {principali.map((t) => (
            <div class="principale">
              <p class="pr-nome">{t.nome || 'Atletica Daini'}{t.ruolo && <span>{t.ruolo}</span>}</p>
              <p class="pr-numero tabnums">{formatTel(t.numero)}</p>
              <div class="pr-azioni">
                <a class="btn primary" href={whatsappHref(t.numero)} target="_blank" rel="noopener"><IconaWhatsApp /> Scrivici su WhatsApp</a>
                <a class="btn" href={telHref(t.numero)}>Chiama</a>
              </div>
            </div>
          ))}
          <div class="azioni-contatto">
            {telefoni.map((t) => (
              <a class="contatto" href={telHref(t.numero)}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                <span><span class="c-tipo">{nomeRuolo(t) || 'Chiama'}</span><span class="c-valore tabnums">{formatTel(t.numero)}</span></span>
              </a>
            ))}
            {s?.email && (
              <a class="contatto" href={`mailto:${s.email}`}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
                <span><span class="c-tipo">Scrivi un'email</span><span class="c-valore">{s.email}</span></span>
              </a>
            )}
          </div>
        </div>
      )}

      {(campo || sede) && (
        <div class="card blocco dove-siamo">
          <h2 class="blocco-titolo">Dove siamo</h2>
          <dl class="luoghi">
            {campo && (
              <div>
                <dt>Campo di allenamento</dt>
                <dd><strong>{campo.nome}</strong>{campo.indirizzo && <><br /><Indirizzo testo={campo.indirizzo} /></>}</dd>
                {campo.ingresso && <dd class="ingresso"><strong>{campo.ingresso}</strong></dd>}
                {indicazioniUrl(campo.indirizzo) && (
                  <dd class="link-luogo"><a class="btn primary" href={indicazioniUrl(campo.indirizzo)} target="_blank" rel="noopener">Indicazioni stradali</a></dd>
                )}
              </div>
            )}
            {/* La sede sociale (uffici) è già nei dati societari qui sotto: qui solo il campo */}
            {!campo && sede && <div><dt>Sede sociale</dt><dd><Indirizzo testo={sede} /></dd></div>}
          </dl>
          {/* Mappa del campo: riempie lo spazio che resta, così il riquadro è alto
              quanto "Chiamaci o scrivici" accanto */}
          {campo && (campo.mappa || campo.indirizzo) && (
            <div class="dove-mappa"><Mappa posizione={campo.mappa} indirizzo={campo.indirizzo} titolo={campo.nome} /></div>
          )}
        </div>
      )}

      {(s?.linkUtili?.length > 0 || conSocial) && (
        <div class="card blocco largo" id="link-utili">
          <h2 class="blocco-titolo">Link utili</h2>
          {s?.linkUtili?.length > 0 && (
            <ul class="link-utili">
              {s.linkUtili.map((l: any) => (
                <li><a href={l.url} target="_blank" rel="noopener"><strong>{l.nome}</strong>{l.nota && <span>{l.nota}</span>}</a></li>
              ))}
            </ul>
          )}
          {conSocial && <div class="social"><p>Seguici sui social</p><SocialIcons social={s.social} classe="su-chiaro" /></div>}
        </div>
      )}

      {dati.length > 0 && (
        <div class="card blocco largo">
          <h2 class="blocco-titolo piccolo">Dati societari</h2>
          <dl class="dati">{dati.map((d) => <div><dt>{d.dt}</dt><dd class="tabnums">{d.dd}</dd></div>)}</dl>
        </div>
      )}

      {!s?.email && telefoni.length === 0 && !campo && !sede && (
        <div class="empty largo"><strong>Recapiti non ancora inseriti</strong>Si compilano nel pannello, alla voce "Impostazioni sito".</div>
      )}
    </div>
  </section>
</Layout>

<style>
  /* PC: due blocchi affiancati, poi quelli larghi; tablet e telefono: uno sotto l'altro */
  .contatti { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(14px, 2.4vw, 22px); align-items: start; }
  .largo { grid-column: 1 / -1; }
  @media (max-width: 1023px) { .contatti { grid-template-columns: minmax(0, 1fr); } }
  .blocco { padding: clamp(20px, 3vw, 30px); }
  .blocco-titolo { font-size: var(--fs-titolo-blocco); margin: 0 0 18px; }
  .blocco-titolo.piccolo { font-size: var(--fs-titolo-scheda); margin-bottom: 14px; }

  /* Numero della società: fondo giallo chiaro e pulsanti, il resto è elenco */
  .principale { background: var(--giallo-chiaro); border-left: 5px solid var(--verde); border-radius: 12px; padding: 16px 18px 18px; margin-bottom: 14px; }
  .pr-nome { margin: 0; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-weight: 800; font-size: var(--fs-etichetta); color: var(--verde); display: flex; flex-direction: column; }
  .pr-nome span { font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-weight: 600; font-size: var(--fs-testo-secondario); color: var(--ink); }
  .pr-numero { margin: 6px 0 12px; font-family: var(--font-display); font-weight: 800; font-size: clamp(calc(var(--fs-numero) * .85), 4vw, var(--fs-numero)); line-height: 1; color: var(--ink); }
  .pr-azioni { display: flex; flex-wrap: wrap; gap: 10px; }
  .pr-azioni .btn { gap: 8px; min-height: 48px; }
  .azioni-contatto { display: flex; flex-direction: column; gap: 10px; }
  .contatto { display: flex; align-items: center; gap: 14px; min-height: 64px; padding: 12px 16px;
    border: 1px solid var(--line); border-radius: 12px; color: var(--ink); transition: border-color .12s ease, transform .12s ease; }
  .contatto:hover { border-color: var(--verde); transform: translateY(-1px); }
  .contatto svg { flex: none; color: var(--verde); }
  .contatto > span { display: flex; flex-direction: column; min-width: 0; }
  .c-tipo { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-size: var(--fs-piccolo); font-weight: 700; color: var(--grigio-verde); }
  .c-valore { font-weight: 600; font-size: var(--fs-testo-grande); overflow-wrap: anywhere; }

  .luoghi { margin: 0; display: flex; flex-direction: column; gap: 20px; }
  .luoghi dt { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-weight: 700; color: var(--grigio-verde); }
  .luoghi dd { margin: 4px 0 0; color: var(--ink); }
  .luoghi .ingresso { padding: 8px 12px; border-left: 4px solid var(--giallo); background: var(--tinta); color: var(--verde-scuro); margin-top: 10px; }
  /* I due riquadri in alto sono alti uguali; in "Dove siamo" la mappa prende il resto */
  .contatti > .blocco:not(.largo) { align-self: stretch; }
  .dove-siamo { display: flex; flex-direction: column; }
  .dove-mappa { flex: 1; display: flex; margin-top: 20px; min-height: 220px; }
  .dove-mappa :global(.mappa) { flex: 1; min-height: 0; }
  /* PC: i riquadri sono affiancati, la mappa riempie quanto serve a pareggiarli */
  @media (min-width: 1024px) { .dove-mappa { min-height: 120px; } }
  .link-luogo { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px !important; }

  .link-utili { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .link-utili a { display: flex; flex-direction: column; justify-content: center; min-height: 56px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; }
  .link-utili a:hover { border-color: var(--verde); }
  .link-utili strong { color: var(--verde); }
  .link-utili span { font-size: var(--fs-piccolo); color: var(--ink-faint); }
  .social { margin-top: 20px; display: flex; flex-direction: column; gap: 10px; }
  .social p { font-family: var(--font-display); text-transform: uppercase; font-weight: 700; letter-spacing: .04em; color: var(--grigio-verde); }
  /* Su fondo bianco le icone diventano verdi */
  .social :global(.su-chiaro a) { color: var(--verde); border-color: var(--line); }

  .dati { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px 24px; margin: 0; }
  .dati dt { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .05em; font-size: var(--fs-piccolo); font-weight: 700; color: var(--grigio-verde); }
  .dati dd { margin: 2px 0 0; color: var(--ink-soft); overflow-wrap: anywhere; }
</style>
