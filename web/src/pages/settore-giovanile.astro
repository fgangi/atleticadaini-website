---
import ElencoDocumenti from '../components/ElencoDocumenti.astro';
import Icona from '../components/Icona.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SchedaCorso from '../components/SchedaCorso.astro';
import IconaWhatsApp from '../components/IconaWhatsApp.astro';
import { sfetch, richText, telHref, formatTel, whatsappHref, nomeRuolo } from '../lib/sanity';
import { settingsQuery, iscrizioniQuery, corsiQuery, openDayQuery, intestazioniQuery } from '../lib/queries';

/**
 * Pagina per chi vuole iscriversi, nell'ordine in cui un genitore si fa le
 * domande: che corsi ci sono e quando → quanto costa → come ci si iscrive →
 * a chi chiedere. Ogni blocco compare solo se nel pannello ci sono i dati.
 */
const [settings, i, corsi, od] = await Promise.all([
  sfetch<any>(settingsQuery, {}, null),
  sfetch<any>(iscrizioniQuery, {}, null),
  sfetch<any[]>(corsiQuery, {}, []),
  sfetch<any>(openDayQuery, {}, null),
]);
// Foto dietro al titolo, scelta nel pannello (Impostazioni → Foto delle intestazioni)
const fotoTesta = (await sfetch<any>(intestazioniQuery, {}, null))?.settoreGiovanile;
const aperte = i?.aperte === true;
const euro = (n?: number | null) => (typeof n === 'number' ? n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: n % 1 ? 2 : 0 }) : '–');
// "Come pagare": un paragrafo per informazione. "Titolo: testo" diventa un
// riquadro con l'etichetta in alto (grassetti e link del pannello restano)
const pagamento = (i?.pagamento ?? []).map((b: any) => {
  const html = richText([b]);
  const m = html.match(/^<p>([^<:]{2,40}):\s*/);
  // Dopo l'etichetta il testo parte con la maiuscola (anche se nel pannello è scritto minuscolo)
  const maiuscola = (h: string) => h.replace(/^(<strong>)?([a-zàèéìòù])/, (_x, t, c) => (t ?? '') + c.toUpperCase());
  return m ? { titolo: m[1], html: maiuscola(html.slice(m[0].length).replace(/<\/p>$/, '')) } : { titolo: null, html: html.replace(/^<p>|<\/p>$/g, '') };
}).filter((x: any) => x.html);
// "Periodo di validità": una riga per informazione. "Titolo: testo" diventa un
// riquadro con l'etichetta in evidenza; le righe senza titolo restano note
const info = String(i?.periodi ?? '').split('\n').map((r) => r.trim()).filter(Boolean).map((r) => {
  const m = r.match(/^([^:]{2,40}):\s*(.+)$/);
  return m ? { titolo: m[1], testo: m[2].charAt(0).toUpperCase() + m[2].slice(1) } : { titolo: null, testo: r };
});
// Una scheda per tipologia: le righe Base e Plus della stessa tipologia si
// affiancano, così il prezzo si confronta a colpo d'occhio
const gruppiQuote = (i?.tariffe ?? []).reduce((acc: any[], t: any) => {
  const g = acc.find((x) => x.tipologia === t.tipologia) ?? acc[acc.push({ tipologia: t.tipologia, righe: [] }) - 1];
  g.righe.push(t);
  return acc;
}, []);
const nomePacchetto = (t: any) => (t.pacchetto === 'plus' ? 'Plus' : 'Base');
const telefoni: any[] = settings?.telefoni ?? [];
const documenti = (i?.documenti ?? []).filter((d: any) => d?.url);
---
<Layout title="Settore giovanile" description="Corsi di atletica leggera a Carate Brianza per ragazze e ragazzi dai 4 anni: orari, quote, moduli e come iscriversi.">
  <PageHero foto={fotoTesta} eyebrow={i?.stagione ? `Stagione ${i.stagione}` : 'Scuola di atletica'} title="Settore giovanile"
    lead="Corsi di atletica leggera dai 4 anni in su, fino al gruppo agonistico, con istruttori federali e laureati in scienze motorie.">
    <div class="azioni hero-azioni">
      <a class="btn cta" href="#iscrizioni">{aperte ? 'Iscriviti' : 'Come iscriversi'}</a>
      {corsi.length > 0 && <a class="btn chiaro vai" href="#corsi">Corsi e orari</a>}
    </div>
  </PageHero>

  {corsi.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head" id="corsi"><span class="eyebrow">Per età</span><h2>Corsi e orari</h2></div>
        <div class:list={['grid', corsi.length >= 3 ? 'cols-3' : 'cols-2']}>
          {corsi.map((c) => <SchedaCorso c={c} completa />)}
        </div>
      </div>
    </section>
  )}

  {/* Open days: invito a provare prima di iscriversi, dopo corsi e orari */}
  {od?.attivo === true && (
    <section class="section open-day-invito sfondo-scuro">
      <div class="container od-riga">
        <div>
          <span class="eyebrow">{od.occhiello || 'Open days'}</span>
          <h2>{od.titolo || "Vieni a provare l'atletica"}</h2>
          {od.testo && <p>{od.testo}</p>}
        </div>
        <a class="btn cta grande vai" href="/open-days/">Scopri gli open days</a>
      </div>
    </section>
  )}

  {i?.tariffe?.length > 0 && (
    <section class="section fascia-tenue">
      <div class="container">
        <div class="section-head" id="quote"><span class="eyebrow">Quote associative{i?.stagione ? ` ${i.stagione}` : ''}</span><h2>Quanto costa</h2></div>
        {i?.abbigliamento?.plus && <p class="intro-quote">Base e Plus cambiano solo per l'abbigliamento compreso nel prezzo.</p>}
        <ul class="quote">
          {gruppiQuote.map((g: any) => (
            <li class="quota">
              <h3>{g.tipologia}</h3>
              <div class:list={['prezzi', { singolo: g.righe.length === 1 }]}>
                {g.righe.map((t: any) => (
                  <div class="prezzo">
                    {/* Cosa comprende il pacchetto scritto sotto il nome: niente legenda da andare a cercare */}
                    <p class="p-pacchetto">
                      <span class:list={['pacchetto', { plus: t.pacchetto === 'plus' }]}>{nomePacchetto(t)}</span>
                      {i?.abbigliamento?.[t.pacchetto ?? 'base'] && <span class="p-include">{i.abbigliamento[t.pacchetto ?? 'base']}</span>}
                    </p>
                    <dl class="p-cifre">
                      <div><dt>Prima iscrizione</dt><dd class="p-nuovi tabnums">{euro(t.nuovi)}</dd></div>
                      {typeof t.rinnovi === 'number' && <div><dt>Già iscritti l'anno scorso</dt><dd class="p-rinnovi tabnums">{euro(t.rinnovi)}</dd></div>}
                    </dl>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ul>
        {i?.noteQuote && <p class="nota-quote">{i.noteQuote}</p>}
        {pagamento.length > 0 && (
          <div class="pagamento">
            <h3>Come pagare</h3>
            <ul class="pag-righe">
              {pagamento.map((x: any) => (
                <li class:list={{ nota: !x.titolo }}>
                  {x.titolo && <span class="pag-tit">{x.titolo}</span>}
                  <span class="pag-testo" set:html={x.html} />
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container iscr">
      <div class="iscr-principale">
        <div class="section-head" id="iscrizioni">
          <span class="eyebrow">{aperte ? 'Iscrizioni aperte' : 'Iscrizioni'}</span>
          <h2>Come iscriversi</h2>
        </div>
        {info.length > 0 && (
          <ul class="info-iscr">
            {info.map((x) => (
              <li class:list={{ senza: !x.titolo }}>
                {x.titolo && <span class="info-tit">{x.titolo}</span>}
                <span class="info-testo">{x.testo}</span>
              </li>
            ))}
          </ul>
        )}
        {i?.lezioneProva?.attiva && (
          <div class="prova"><strong>Lezione di prova</strong><p>{i.lezioneProva.testo || 'Prima di iscriverti puoi venire a provare: contattaci per concordare il giorno.'}</p></div>
        )}
        {i?.requisiti?.length > 0 && (
          <>
            <h3 class="sotto">Cosa serve</h3>
            {/* Le parole fra asterischi vanno in grassetto, come su WhatsApp */}
            <ol class="requisiti">{i.requisiti.map((r: string) => <li>{r.split(/\*([^*]+)\*/).map((x, k) => k % 2 ? <strong>{x}</strong> : x)}</li>)}</ol>
          </>
        )}
        {i?.linkModulo && aperte && <a class="btn cta grande" href={i.linkModulo} target="_blank" rel="noopener">Compila l'iscrizione online</a>}
        {!info.length && !i?.requisiti?.length && (
          <p>Per informazioni su corsi e iscrizioni vieni al campo prima o dopo gli allenamenti, oppure contattaci.</p>
        )}
      </div>

      <aside class="iscr-lato">
        {documenti.length > 0 && (
          <div class="card blocco" id="moduli">
            <h3>Moduli da scaricare</h3>
            <ElencoDocumenti documenti={documenti} />
          </div>
        )}
        {(telefoni.length > 0 || settings?.email) && (
          <div class="card blocco">
            <h3>Hai domande?</h3>
            <ul class="referenti">
              {telefoni.map((t) => (
                <li>{t.principale
                  ? <a class="btn primary" href={whatsappHref(t.numero)} target="_blank" rel="noopener"><IconaWhatsApp size={20} /><span class="tabnums">{formatTel(t.numero)}</span><span class="tel-nome"><span class="solo-largo">Scrivici su </span>WhatsApp</span></a>
                  : <a class="btn" href={telHref(t.numero)}><Icona nome="tel" size={20} /><span class="tabnums">{formatTel(t.numero)}</span>{t.nome && <span class="tel-nome">{nomeRuolo(t)}</span>}</a>}</li>
              ))}
              {settings?.email && <li><a class="btn cta email" href={`mailto:${settings.email}`}><Icona nome="mail" size={20} /><span>{settings.email}</span></a></li>}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</Layout>

<style>
  .hero-azioni { margin-top: 22px; }
  .open-day-invito { background: var(--sfondo-scuro); color: #fff; }
  .od-riga { display: flex; align-items: center; justify-content: space-between; gap: 20px 40px; flex-wrap: wrap; }
  .od-riga h2 { color: #fff; }
  .od-riga .eyebrow { color: var(--giallo); }
  .od-riga p { color: #E3EAE1; margin-top: 10px; max-width: 56ch; }
  .open-day-invito .btn.grande { min-height: 52px; font-size: var(--fs-pulsante-grande); }

  .intro-quote { margin: -6px 0 18px; font-size: var(--fs-testo); color: var(--ink); max-width: 60ch; }
  .pacchetto { display: inline-block; align-self: flex-start; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: .06em;
    font-size: var(--fs-piccolo); line-height: 1; padding: .4rem .7rem; border-radius: 999px; background: var(--tinta); color: var(--verde); }
  .pacchetto.plus { background: var(--verde); color: var(--giallo); }

  /* Schede delle quote: una colonna su telefono, due da tablet in su.
     Se le schede sono dispari, l'ultima occupa tutta la riga invece di
     restare sola a metà */
  .quote { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) {
    .quote { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quota:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .quota { display: flex; flex-direction: column; background: var(--ground); border-radius: var(--radius); border-top: 5px solid var(--verde); padding: 18px 18px 20px; }
  .quota h3 { font-size: var(--fs-titolo-scheda); line-height: 1.2; color: var(--verde); margin-bottom: 14px; }
  /* Sottogriglia: i prezzi di Base e Plus stanno alla stessa altezza anche
     se "cosa comprende" va a capo su più righe in una sola colonna */
  .prezzi { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; column-gap: 14px; }
  .prezzi.singolo { grid-template-columns: 1fr; }
  .prezzo { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 12px; }
  .prezzo + .prezzo { border-left: 1px solid var(--filetto); padding-left: 14px; }
  .p-pacchetto { display: flex; flex-direction: column; gap: 6px; margin: 0; }
  .p-include { font-size: var(--fs-testo-secondario); line-height: 1.35; color: var(--ink); }
  .p-cifre { margin: 0; display: flex; flex-direction: column; gap: 10px; padding-top: 10px; border-top: 1px solid var(--filetto); }
  .p-cifre dt { font-size: var(--fs-piccolo); line-height: 1.3; color: var(--ink-soft); }
  .p-cifre dd { margin: 2px 0 0; font-family: var(--font-display); font-weight: 800; line-height: 1; color: var(--ink); }
  .p-nuovi { font-size: var(--fs-numero); }
  .p-rinnovi { font-size: var(--fs-numero-piccolo); }
  .nota-quote { margin-top: 14px; font-weight: 600; color: var(--verde); }
  /* Come pagare: riquadri bianchi affiancati, etichetta piccola sopra e testo sotto */
  .pagamento { margin-top: 30px; }
  .pagamento h3 { font-size: var(--fs-titolo-scheda); margin-bottom: 12px; }
  .pag-righe { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  /* Da tablet in su due per riga: i riquadri restano larghi abbastanza da non andare a capo ogni due parole */
  @media (min-width: 640px) { .pag-righe { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pag-righe li { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; background: var(--ground); border-left: 4px solid var(--verde); border-radius: 0 10px 10px 0; }
  .pag-righe li.nota { grid-column: 1 / -1; background: none; border: 0; padding: 0; }
  .pag-tit { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .05em; font-weight: 700; font-size: var(--fs-piccolo); color: var(--verde); }
  .pag-testo { color: var(--ink); line-height: 1.45; }
  .pag-testo :global(strong) { color: var(--verde-scuro); }
  .pag-testo :global(a) { color: var(--verde); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  .iscr { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: start; }
  @media (max-width: 1023px) { .iscr { grid-template-columns: minmax(0, 1fr); } }
  .iscr-principale { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .iscr-principale .section-head { margin-bottom: 4px; }
  /* Informazioni sull'iscrizione a riquadri: etichetta in alto, testo sotto */
  .info-iscr { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .info-iscr li { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; background: var(--tinta); border-left: 4px solid var(--verde); border-radius: 0 10px 10px 0; }
  .info-tit { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .05em; font-weight: 700; font-size: var(--fs-piccolo); color: var(--verde); }
  .info-testo { color: var(--ink); font-weight: 600; line-height: 1.45; }
  .info-iscr li.senza .info-testo { font-weight: 400; color: var(--ink-soft); }
  .prova { border-left: 4px solid var(--giallo); background: var(--tinta); padding: 12px 16px; border-radius: 0 10px 10px 0; }
  .prova strong { color: var(--verde); }
  .sotto { margin-top: 8px; }
  .requisiti { margin: 0; padding-left: 1.3rem; display: flex; flex-direction: column; gap: 6px; color: var(--ink-soft); }
  .requisiti strong { color: var(--ink); font-weight: 700; }
  .btn.grande { min-height: 52px; font-size: var(--fs-pulsante-grande); margin-top: 6px; }

  .iscr-lato { display: flex; flex-direction: column; gap: 16px; }
  .blocco { padding: 20px; }
  .blocco h3 { margin-bottom: 12px; }
  .referenti { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  /* Il numero non va mai a capo; se manca spazio va a capo il nome */
  .referenti .tabnums { flex: none; white-space: nowrap; }
  .referenti .tel-nome { min-width: 0; line-height: 1.25; }
  .tel-nome { margin-left: .2em; color: var(--ink-faint); font-weight: 500; }
  /* Icona sempre a sinistra e della stessa misura: numeri, email e nomi partono tutti dalla stessa colonna */
  .referenti .btn { width: 100%; justify-content: flex-start; gap: 12px; text-transform: none; font-family: var(--font-body); font-weight: 600; font-size: var(--fs-testo-secondario); letter-spacing: 0; }
  /* Pulsante del numero della società: numero chiaro, leggibile sul verde */
  /* Numero a sinistra come negli altri pulsanti; l'icona chiude la riga a destra */
  /* Stessa spaziatura delle altre righe: numeri e nomi restano in colonna */
  .referenti .btn.primary .tel-nome { color: #DCE6D8; }
  /* Sul telefono la riga è stretta: resta "WhatsApp", senza andare a capo */
  @media (max-width: 479px) { .referenti .solo-largo { display: none; } }
</style>
