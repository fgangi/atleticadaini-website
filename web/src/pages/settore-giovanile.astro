---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SchedaCorso from '../components/SchedaCorso.astro';
import IconaWhatsApp from '../components/IconaWhatsApp.astro';
import { sfetch, richText, telHref, formatTel, whatsappHref, nomeRuolo } from '../lib/sanity';
import { settingsQuery, iscrizioniQuery, corsiQuery, openDayQuery } from '../lib/queries';

/**
 * Pagina per chi vuole iscriversi, nell'ordine in cui un genitore si fa le
 * domande: che corsi ci sono e quando → quanto costa → come ci si iscrive →
 * a chi chiedere. Ogni blocco compare solo se nel pannello ci sono i dati.
 */
const [settings, i, corsi, od] = await Promise.all([
  sfetch<any>(settingsQuery, {}, null),
  sfetch<any>(iscrizioniQuery, {}, null),
  sfetch<any[]>(corsiQuery, {}, []),
  sfetch<any>(openDayQuery, {}, null),
]);
const aperte = i?.aperte === true;
const euro = (n?: number | null) => (typeof n === 'number' ? n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: n % 1 ? 2 : 0 }) : '–');
const pagamento = richText(i?.pagamento);
// Una scheda per tipologia: le righe Base e Plus della stessa tipologia si
// affiancano, così il prezzo si confronta a colpo d'occhio
const gruppiQuote = (i?.tariffe ?? []).reduce((acc: any[], t: any) => {
  const g = acc.find((x) => x.tipologia === t.tipologia) ?? acc[acc.push({ tipologia: t.tipologia, righe: [] }) - 1];
  g.righe.push(t);
  return acc;
}, []);
const nomePacchetto = (t: any) => (t.pacchetto === 'plus' ? 'Plus' : 'Base');
const telefoni: any[] = settings?.telefoni ?? [];
const documenti = (i?.documenti ?? []).filter((d: any) => d?.url);
---
<Layout title="Settore giovanile" description="Corsi di atletica leggera a Carate Brianza per ragazze e ragazzi dai 4 anni: orari, quote, moduli e come iscriversi.">
  <PageHero eyebrow={i?.stagione ? `Stagione ${i.stagione}` : 'Scuola di atletica'} title="Settore giovanile"
    lead="Corsi di atletica leggera dai 4 anni in su, fino al gruppo agonistico e ai master, con istruttori federali e laureati in scienze motorie.">
    <div class="azioni hero-azioni">
      <a class="btn cta" href="#iscrizioni">{aperte ? 'Iscriviti' : 'Come iscriversi'}</a>
      {corsi.length > 0 && <a class="btn chiaro" href="#corsi">Corsi e orari</a>}
    </div>
  </PageHero>

  {corsi.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head" id="corsi"><span class="eyebrow">Per età</span><h2>Corsi e orari</h2></div>
        <div class:list={['grid', corsi.length >= 3 ? 'cols-3' : 'cols-2']}>
          {corsi.map((c) => <SchedaCorso c={c} completa />)}
        </div>
      </div>
    </section>
  )}

  {/* Open days: invito a provare prima di iscriversi, dopo corsi e orari */}
  {od?.attivo === true && (
    <section class="section open-day-invito sfondo-scuro">
      <div class="container od-riga">
        <div>
          <span class="eyebrow">{od.occhiello || 'Open days'}</span>
          <h2>{od.titolo || "Vieni a provare l'atletica"}</h2>
          {od.testo && <p>{od.testo}</p>}
        </div>
        <a class="btn cta grande" href="/open-days/">Scopri gli open days</a>
      </div>
    </section>
  )}

  {i?.tariffe?.length > 0 && (
    <section class="section fascia-tenue">
      <div class="container">
        <div class="section-head" id="quote"><span class="eyebrow">Quote associative{i?.stagione ? ` ${i.stagione}` : ''}</span><h2>Quanto costa</h2></div>
        {i?.abbigliamento?.plus && <p class="intro-quote">Base e Plus cambiano solo per l'abbigliamento compreso nel prezzo.</p>}
        <ul class="quote">
          {gruppiQuote.map((g: any) => (
            <li class="quota">
              <h3>{g.tipologia}</h3>
              <div class:list={['prezzi', { singolo: g.righe.length === 1 }]}>
                {g.righe.map((t: any) => (
                  <div class="prezzo">
                    {/* Cosa comprende il pacchetto scritto sotto il nome: niente legenda da andare a cercare */}
                    <p class="p-pacchetto">
                      <span class:list={['pacchetto', { plus: t.pacchetto === 'plus' }]}>{nomePacchetto(t)}</span>
                      {i?.abbigliamento?.[t.pacchetto ?? 'base'] && <span class="p-include">{i.abbigliamento[t.pacchetto ?? 'base']}</span>}
                    </p>
                    <dl class="p-cifre">
                      <div><dt>Prima iscrizione</dt><dd class="p-nuovi tabnums">{euro(t.nuovi)}</dd></div>
                      {typeof t.rinnovi === 'number' && <div><dt>Già iscritti l'anno scorso</dt><dd class="p-rinnovi tabnums">{euro(t.rinnovi)}</dd></div>}
                    </dl>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ul>
        {i?.noteQuote && <p class="nota-quote">{i.noteQuote}</p>}
        {pagamento && <div class="prose pagamento"><h3>Come pagare</h3><div set:html={pagamento} /></div>}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container iscr">
      <div class="iscr-principale">
        <div class="section-head" id="iscrizioni">
          <span class="eyebrow">{aperte ? 'Iscrizioni aperte' : 'Iscrizioni'}</span>
          <h2>Come iscriversi</h2>
        </div>
        {i?.periodi && <p class="periodi">{i.periodi}</p>}
        {i?.lezioneProva?.attiva && (
          <div class="prova"><strong>Lezione di prova</strong><p>{i.lezioneProva.testo || 'Prima di iscriverti puoi venire a provare: contattaci per concordare il giorno.'}</p></div>
        )}
        {i?.requisiti?.length > 0 && (
          <>
            <h3 class="sotto">Cosa serve</h3>
            <ol class="requisiti">{i.requisiti.map((r: string) => <li>{r}</li>)}</ol>
          </>
        )}
        {i?.linkModulo && aperte && <a class="btn cta grande" href={i.linkModulo} target="_blank" rel="noopener">Compila l'iscrizione online</a>}
        {!i?.periodi && !i?.requisiti?.length && (
          <p>Per informazioni su corsi e iscrizioni vieni al campo prima o dopo gli allenamenti, oppure contattaci.</p>
        )}
      </div>

      <aside class="iscr-lato">
        {documenti.length > 0 && (
          <div class="card blocco" id="moduli">
            <h3>Moduli da scaricare</h3>
            <ul class="documenti">
              {documenti.map((d: any) => (
                <li>
                  <a href={`${d.url}?dl=`} download>
                    <span class="doc-ico" aria-hidden="true">{(d.est ?? 'pdf').toUpperCase()}</span>
                    <span><span class="doc-titolo">{d.titolo}</span>{d.descrizione && <span class="doc-desc">{d.descrizione}</span>}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {(telefoni.length > 0 || settings?.email) && (
          <div class="card blocco">
            <h3>Hai domande?</h3>
            <ul class="referenti">
              {telefoni.map((t) => (
                <li>{t.principale
                  ? <a class="btn primary" href={whatsappHref(t.numero)} target="_blank" rel="noopener"><span class="tabnums">{formatTel(t.numero)}</span><span class="tel-nome"><span class="solo-largo">Scrivici su </span>WhatsApp</span><IconaWhatsApp /></a>
                  : <a class="btn" href={telHref(t.numero)}><span class="tabnums">{formatTel(t.numero)}</span>{t.nome && <span class="tel-nome">{nomeRuolo(t)}</span>}</a>}</li>
              ))}
              {settings?.email && <li><a class="btn cta" href={`mailto:${settings.email}`}>{settings.email}</a></li>}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</Layout>

<style>
  .hero-azioni { margin-top: 22px; }
  .open-day-invito { background: var(--sfondo-scuro); color: #fff; }
  .od-riga { display: flex; align-items: center; justify-content: space-between; gap: 20px 40px; flex-wrap: wrap; }
  .od-riga h2 { color: #fff; }
  .od-riga .eyebrow { color: var(--giallo); }
  .od-riga p { color: #E3EAE1; margin-top: 10px; max-width: 56ch; }
  .open-day-invito .btn.grande { min-height: 52px; font-size: 1.15rem; }

  .intro-quote { margin: -6px 0 18px; font-size: 1.05rem; color: var(--ink); max-width: 60ch; }
  .pacchetto { display: inline-block; align-self: flex-start; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: .06em;
    font-size: .95rem; line-height: 1; padding: .4rem .7rem; border-radius: 999px; background: var(--tinta); color: var(--verde); }
  .pacchetto.plus { background: var(--verde); color: var(--giallo); }

  /* Schede delle quote: una colonna su telefono, due da tablet in su.
     Se le schede sono dispari, l'ultima occupa tutta la riga invece di
     restare sola a metà */
  .quote { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) {
    .quote { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quota:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .quota { display: flex; flex-direction: column; background: var(--ground); border-radius: var(--radius); border-top: 5px solid var(--verde); padding: 18px 18px 20px; }
  .quota h3 { font-size: 1.25rem; line-height: 1.2; color: var(--verde); margin-bottom: 14px; }
  /* Sottogriglia: i prezzi di Base e Plus stanno alla stessa altezza anche
     se "cosa comprende" va a capo su più righe in una sola colonna */
  .prezzi { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; column-gap: 14px; }
  .prezzi.singolo { grid-template-columns: 1fr; }
  .prezzo { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 12px; }
  .prezzo + .prezzo { border-left: 1px solid var(--filetto); padding-left: 14px; }
  .p-pacchetto { display: flex; flex-direction: column; gap: 6px; margin: 0; }
  .p-include { font-size: 1rem; line-height: 1.35; color: var(--ink); }
  .p-cifre { margin: 0; display: flex; flex-direction: column; gap: 10px; padding-top: 10px; border-top: 1px solid var(--filetto); }
  .p-cifre dt { font-size: .95rem; line-height: 1.3; color: var(--ink-soft); }
  .p-cifre dd { margin: 2px 0 0; font-family: var(--font-display); font-weight: 800; line-height: 1; color: var(--ink); }
  .p-nuovi { font-size: 2rem; }
  .p-rinnovi { font-size: 1.5rem; }
  .nota-quote { margin-top: 14px; font-weight: 600; color: var(--verde); }
  .pagamento { margin-top: 26px; max-width: 70ch; }
  .pagamento h3 { font-size: 1.25rem; }

  .iscr { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: start; }
  @media (max-width: 1023px) { .iscr { grid-template-columns: minmax(0, 1fr); } }
  .iscr-principale { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .iscr-principale .section-head { margin-bottom: 4px; }
  .periodi { white-space: pre-line; color: var(--ink); }
  .prova { border-left: 4px solid var(--giallo); background: var(--tinta); padding: 12px 16px; border-radius: 0 10px 10px 0; }
  .prova strong { color: var(--verde); }
  .sotto { margin-top: 8px; }
  .requisiti { margin: 0; padding-left: 1.3rem; display: flex; flex-direction: column; gap: 6px; color: var(--ink-soft); }
  .btn.grande { min-height: 52px; font-size: 1.15rem; margin-top: 6px; }

  .iscr-lato { display: flex; flex-direction: column; gap: 16px; }
  .blocco { padding: 20px; }
  .blocco h3 { margin-bottom: 12px; }
  .documenti, .referenti { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .documenti a { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px;
    transition: border-color .12s ease; }
  .documenti a:hover { border-color: var(--verde); }
  .doc-ico { flex: none; width: 40px; height: 40px; border-radius: 8px; background: var(--verde); color: var(--giallo-chiaro);
    display: grid; place-items: center; font-family: var(--font-display); font-weight: 800; font-size: .9rem; }
  .doc-titolo { display: block; font-weight: 600; color: var(--ink); line-height: 1.3; }
  .doc-desc { display: block; font-size: .92rem; color: var(--ink-faint); }
  .tel-nome { margin-left: .6em; color: var(--ink-faint); font-weight: 500; }
  .referenti .btn { width: 100%; justify-content: flex-start; text-transform: none; font-family: var(--font-body); font-weight: 600; font-size: 1rem; letter-spacing: 0; }
  /* Pulsante del numero della società: numero chiaro, leggibile sul verde */
  /* Numero a sinistra come negli altri pulsanti; l'icona chiude la riga a destra */
  /* Stessa spaziatura delle altre righe: numeri e nomi restano in colonna */
  .referenti .btn.primary .tel-nome { color: #DCE6D8; }
  /* Sul telefono la riga è stretta: resta "WhatsApp", senza andare a capo */
  @media (max-width: 479px) { .referenti .solo-largo { display: none; } }
</style>
