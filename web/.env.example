# Copia in .env e inserisci i valori. Nessun dato di account va scritto nel codice:
# per passare il sito alla società basta cambiare questi valori.
PUBLIC_SANITY_PROJECT_ID=il-tuo-project-id
PUBLIC_SANITY_DATASET=production
# Indirizzo pubblico del sito (canonical, sitemap, anteprime dei link)
PUBLIC_SITE_URL=http://localhost:4321
# "true" solo sul sito definitivo: altrimenti noindex e robots.txt che blocca tutto
PUBLIC_INDICIZZABILE=false
